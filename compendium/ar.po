msgstr "6 - أداة الزراعة"

msgid "6 repeats"
msgstr "6 تكرارات"

msgid "60% Complete"
msgstr "اكتمل 60٪"

msgid "70% Complete"
msgstr "اكتمل 70%"

msgid "75% overlap in the images, so that the images can be properly assembled."
msgstr "يجب أن يكون التداخل بين الصور 75% حتى يمكن دمجها بشكل صحيح."

msgid "8 repeats"
msgstr "8 تكرارات"

msgid ": A number 1 through 5, related to  dx.doi.org/10.1021/es5002105."
msgstr ": عدد من 1 إلى 5 مرتبط بـ dx.doi.org/10.1021/es5002105."

msgid ": Chemical formula of the metabolite (e.g., C6H6O3)."
msgstr ": الصيغة الكيميائية للمستقلب (مثل C6H6O3)."

msgid ": Could be negative or positive."
msgstr ": قد تكون سالبة أو موجبة."

msgid ": For adding many items with different stock types and each item may have different catalog info, you can use \"Upload Multiple Items\" dialog."
msgstr ": لإضافة عناصر كثيرة من أنواع مواد مختلفة ومعلومات فهرس مختلفة، استخدم مربع حوار «تحميل عناصر متعددة»."

msgid ": For adding many items with the same stock type and the same catalog info, using \"Add Multiple Items Using List\" dialog is the most convenient method."
msgstr ": لإضافة عناصر كثيرة من النوع نفسه وبمعلومات فهرس متطابقة، استخدم مربع حوار «إضافة عناصر متعددة باستخدام قائمة»."

msgid ": If you would like to add only one item to the catalog, you can use \"Add Single Item\" dialog"
msgstr ": لإضافة عنصر واحد فقط إلى الفهرس، استخدم مربع حوار «إضافة عنصر واحد»"

msgid ": M/Z ratio, standard from output, should be a number."
msgstr ": نسبة M/Z القياسية في الناتج؛ يجب أن تكون عددًا."

msgid ": Metabolite synonyms, alternate names of any of the above."
msgstr ": مرادفات المستقلب وأسماء بديلة لأي مما سبق."

msgid ": Metabolomics database (e.g., gmd.mpimp-golm.mpg.de)."
msgstr ": قاعدة بيانات الأيضوميات (مثل gmd.mpimp-golm.mpg.de)."

msgid ": Metabolomics database version (e.g., var5 alk 161212)."
msgstr ": إصدار قاعدة بيانات الأيضوميات (مثل var5 alk 161212)."

msgid ": Name for the compound."
msgstr ": اسم المركب."

msgid ": Optional comments for any information to include. Can include specific sample preparation for measurement."
msgstr ": ملاحظات اختيارية لأي معلومات، بما فيها التحضير الخاص للعينة للقياس."

msgid ": Optional identifier to differentiate device (e.g. serial number). Can be numeric or letter."
msgstr ": معرّف اختياري لتمييز الجهاز، مثل الرقم التسلسلي. يمكن أن يكون رقميًا أو حرفيًا."

msgid ": Plants derived from reducing the chromosome set from 4 to 2."
msgstr ": نباتات ناتجة عن خفض عدد المجموعات الصبغية من 4 إلى 2."

msgid ": Plants derived from reducing the chromosome set from tetraploid to diploid."
msgstr ": نباتات ناتجة عن خفض الصبغيات من الصيغة الرباعية إلى الصيغة الثنائية."

msgid ": Retention time, also standard from machine output; users should confirm that unit is 'seconds'."
msgstr ": زمن الاحتجاز من ناتج الجهاز القياسي؛ تأكد من أن الوحدة هي 'seconds'."

msgid ": Score given by search engine."
msgstr ": الدرجة التي يمنحها محرك البحث."

msgid ": Standard formula (e.g., CHEBI:16971) identifier for the metabolite."
msgstr ": معرّف قياسي للمستقلب (مثل CHEBI:16971)."

msgid ": Standard formula (e.g., https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:75854) identifier for the metabolite."
msgstr ": معرّف قياسي للمستقلب (مثل https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:75854)."

msgid ": Standard identifier (eg., Oc1ccc(O)c(O)c1) for the metabolite."
msgstr ": معرّف قياسي للمستقلب (مثل Oc1ccc(O)c(O)c1)."

msgid ": Target numbers of seeds/progenies can be uploaded to the database using a spreadsheet. Please use \"Upload Target Numbers\" link in this section"
msgstr ": يمكن تحميل الأعداد المستهدفة للبذور/النسل إلى قاعدة البيانات باستخدام جدول بيانات. يرجى استخدام رابط «تحميل الأعداد المستهدفة» في هذا القسم"

msgid ": The International Chemical Identifier (e.g, InChI=1S/C6H6O3/c7-4-1-2-5(8)6(9)3-4/h1-3,7-9H) for the metabolite."
msgstr ": المعرّف الكيميائي الدولي للمستقلب (مثل InChI=1S/C6H6O3/c7-4-1-2-5(8)6(9)3-4/h1-3,7-9H)."

msgid ": The International Chemical Identifier (shortened version of inchi_id) for the metabolite."
msgstr ": المعرّف الكيميائي الدولي للمستقلب، وهو نسخة مختصرة من inchi_id."

msgid ": This is if the metabolite was modified to make it easier to measure on the instrument, and what it was modified too (e.g. trimethylsilation)."
msgstr ": يوضح ما إذا كان المستقلب قد عُدّل لتسهيل قياسه على الجهاز وكيف عُدّل (مثل trimethylsilation)."

msgid ": This should be a sample name that exists in the database. The sample can come from a sampling trial or a field trial or a genotyping plate."
msgstr ": اسم عينة موجودة في قاعدة البيانات. يمكن أن تأتي من تجربة أخذ عينات أو تجربة حقلية أو صفيحة تنميط جيني."

msgid ": This should be the same name as present in a column in your metabolomics data matrix file."
msgstr ": يجب أن يطابق الاسم الموجود في أحد أعمدة ملف مصفوفة بيانات الأيضوميات."

msgid ": You can indicate target numbers of seeds and/or progenies by using a list of female accessions and a list of male accessions. Please use \"Using Lists to Record Target Numbers\" link in this section"
msgstr ": يمكن تحديد الأعداد المستهدفة للبذور و/أو النسل باستخدام قائمة عينات أنثوية وقائمة عينات ذكرية. يرجى استخدام رابط «تسجيل الأعداد المستهدفة باستخدام القوائم» في هذا القسم"

