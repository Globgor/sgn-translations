msgid "This trait value should be numeric. Plot Name: {plot}. Trait Name: {trait}. Value: {value}"
msgstr "El valor de este carácter debe ser numérico. Nombre de la parcela: {plot}. Nombre del carácter: {trait}. Valor: {value}"

