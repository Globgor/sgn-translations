msgstr "Este paso puede aparecer rellenado si utiliza un modelo ya guardado en la base de datos. Si los campos de entrada están deshabilitados, continúe al siguiente paso."

msgid "This stock id is not a cross. Cannot delete.\n"
msgstr "El material con este identificador no es un cruzamiento. No se puede eliminar.\n"

msgid "This stock id is not a family. Cannot delete.\n"
msgstr "El material con este identificador no es una familia. No se puede eliminar.\n"

