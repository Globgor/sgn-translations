msgstr "يجب أن يكون بتنسيق ملف Excel من نوع .xls أو .xlsx"

#: mason/breeders_toolbox/upload_phenotype_datacollector.mas
#: mason/breeders_toolbox/upload_phenotype_spreadsheet.mas
msgid "Two or more traits can be uploaded at the same time."
msgstr "يمكن تحميل صفتين أو أكثر في الوقت نفسه."

#: mason/breeders_toolbox/upload_phenotype_spreadsheet.mas
msgid "Upload Phenotype Spreadsheet"
msgstr "تحميل جدول بيانات النمط الظاهري"

#: mason/breeders_toolbox/upload_phenotype_spreadsheet.mas
