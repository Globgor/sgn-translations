msgstr "حاول إرسال التجربة مرة أخرى"

#: mason/breeders_toolbox/trial/trial_upload_dialogs.mas
msgid "Finished! Your trial is now in the database"
msgstr "انتهى! أصبحت تجربتك الآن في قاعدة البيانات"

#: mason/breeders_toolbox/trial/trial_upload_dialogs.mas
msgid "The trial file was uploaded successfully"
msgstr "تم تحميل ملف التجربة بنجاح"

#: mason/breeders_toolbox/trial/trial_upload_dialogs.mas
msgid "Trials may be uploaded in an Excel file (.xls or .xlsx)"
msgstr "يمكن تحميل التجارب في ملف Excel ‏(.xls أو .xlsx)"

#: mason/breeders_toolbox/trial/trial_upload_dialogs.mas
msgid "Header as a string:"
msgstr "الرأس كسلسلة نصية:"

#: mason/breeders_toolbox/trial/trial_upload_dialogs.mas
#, perl-brace-format
msgid ""
"{plot_name} (must be unique across entire database. If not provided in the "
"file, it will be automatically generated as {trial_name_plot_plot_number}, "
"or according to a plot name template if specified.)"
msgstr ""
"{plot_name} (يجب أن يكون فريدًا في قاعدة البيانات بأكملها. إذا لم يُقدم في "
