#, perl-brace-format
msgid "1. Paste a {bold}sequence{end_bold} like in the example:"
msgstr "1. الصق {bold}تسلسلاً{end_bold} كما في المثال:"

#: mason/tools/motifs_finder/index.mas
#, perl-brace-format
msgid ""
"Or Upload a {bold}sequence file{end_bold}. It must be in {bold}FASTA "
"format{end_bold}."
msgstr ""
"أو حمّل {bold}ملف تسلسل{end_bold}. يجب أن يكون {bold}بتنسيق FASTA{end_bold}."

#: mason/tools/motifs_finder/index.mas
#, perl-brace-format
msgid ""
"2. Enter {bold}motif width(s){end_bold}, a width for each motif must be "
