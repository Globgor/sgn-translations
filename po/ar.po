#: mason/breeders_toolbox/drone_imagery/upload_drone_imagery_dialogs.mas
msgid "Image Info"
msgstr "معلومات الصورة"

#: mason/breeders_toolbox/drone_imagery/upload_drone_imagery_dialogs.mas
msgid "Select Image(s) to Upload"
msgstr "حدد الصور لرفعها"

#: mason/breeders_toolbox/drone_imagery/upload_drone_imagery_dialogs.mas
