#, perl-brace-format
msgid "{column} Must exist in the marker information file."
msgstr "{column} يجب أن يكون موجوداً في ملف معلومات الواسمات."

#: mason/breeders_toolbox/genotyping_trials/upload_genotyping_data_dialogs.mas
#, perl-brace-format
