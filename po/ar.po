msgstr "{link}الكائنات الحية{end_link} - البحث عن الكائنات الحية"

#: mason/search/advanced_search.mas
#, perl-brace-format
msgid "{link}Genes{end_link} - Gene search."
msgstr "{link}الجينات{end_link} - البحث عن الجينات."

#: mason/search/advanced_search.mas
#, perl-brace-format
msgid ""
"{link}Genome features{end_link} - Search for many types of annotations and "
"sequences."
msgstr ""
"{link}معالم الجينوم{end_link} - البحث عن أنواع عديدة من التعليقات التوضيحية "
"والتسلسلات."

#: mason/search/advanced_search.mas
#, perl-brace-format
msgid ""
"{link}Phenotypes{end_link} - Search for mutants, accessions, and traits."
msgstr "{link}الأنماط الظاهرية{end_link} - البحث عن الطفرات والمدخلات والصفات."

#: mason/search/advanced_search.mas
#, perl-brace-format
msgid ""
"{link}QTLs{end_link} - A web interface for uploading QTL raw data, on-the-"
"fly QTL mapping and search interface for QTLs."
msgstr ""
"{link}QTLs{end_link} - واجهة ويب لتحميل بيانات QTL الخام، ورسم خريطة QTL "
"مباشرةً، والبحث عن QTLs."

#: mason/search/advanced_search.mas
