#: mason/breeders_toolbox/manage_drone_imagery.mas
msgid "Remove Background Using Percentage Threshold"
msgstr "إزالة الخلفية بعتبة مئوية"

#: mason/breeders_toolbox/manage_drone_imagery.mas
msgid "Remove the background by specifying percentage threshold value"
msgstr "أزل الخلفية بتحديد قيمة عتبة مئوية"

#: mason/breeders_toolbox/manage_drone_imagery.mas
msgid "Apply Threshold"
msgstr "تطبيق العتبة"

#: mason/breeders_toolbox/manage_drone_imagery.mas
msgid "Histogram of Pixel Values"
msgstr "مدرج تكراري لقيم البكسلات"

#: mason/breeders_toolbox/manage_drone_imagery.mas
msgid "Histogram of pixel values"
msgstr "مدرج تكراري لقيم البكسلات"

#: mason/breeders_toolbox/manage_drone_imagery.mas
