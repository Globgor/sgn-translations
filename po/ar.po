msgstr "معلومات قالب البيانات الوصفية للتجربة"

#: mason/breeders_toolbox/trial/trial_upload_dialogs.mas
#, perl-brace-format
msgid "{trial_name} the name of the trial (must already exist in the database)"
msgstr "{trial_name} اسم التجربة (يجب أن يكون موجودًا بالفعل في قاعدة البيانات)"

#: mason/breeders_toolbox/trial/trial_upload_dialogs.mas
#, perl-brace-format
msgid ""
"{column} (The name of the folder to display the trial in on the Manage > "
"Field Trials page. If the folder does not exist, a new one will be created "
"under the trial's breeding program)"
msgstr ""
"{column} (اسم المجلد الذي ستُعرض فيه التجربة في صفحة إدارة > التجارب الحقلية. "
"إذا لم يكن المجلد موجودًا، فسيُنشأ مجلد جديد ضمن برنامج تربية التجربة)"

#: mason/breeders_toolbox/trial/update_experimental_design_type.mas
