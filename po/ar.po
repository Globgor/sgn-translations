msgstr "التجارب الحقلية التي تحتوي على عينات أنسجة"

#: mason/breeders_toolbox/tissue_samples/sampling_trials.mas
msgid "Sampling Trials"
msgstr "تجارب أخذ العينات"

#: mason/breeders_toolbox/tissue_samples/sampling_trials.mas
msgid "Sampling Facility"
msgstr "منشأة أخذ العينات"

