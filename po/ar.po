#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
msgid "Individual Crosses:"
msgstr "التهجينات الفردية:"

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
#, perl-brace-format
msgid ""
"{bold}biparental:{end_bold} An individual plant pollinated by another "
"individual plant."
msgstr "{bold}ثنائي الأبوين:{end_bold} نبات فردي لُقّح بنبات فردي آخر."

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
#, perl-brace-format
msgid "{bold}self:{end_bold} A self pollinated individual plant."
msgstr "{bold}تلقيح ذاتي:{end_bold} نبات فردي لُقّح ذاتياً."

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
#, perl-brace-format
msgid ""
"{bold}open pollinated:{end_bold} An individual plant pollinated by a group "
"of plants or open pollinated (pollen may be from a group with known or "
"unknown members)."
msgstr ""
"{bold}تلقيح حر:{end_bold} نبات فردي لُقّح بمجموعة من النباتات أو تلقيحاً حراً "
"(قد تأتي حبوب اللقاح من مجموعة معروفة الأفراد أو مجهولتهم)."

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
#, perl-brace-format
msgid ""
"{bold}backcross:{end_bold} An individual plant pollinated by one of its "
"parents."
msgstr "{bold}تهجين رجعي:{end_bold} نبات فردي لُقّح بأحد أبويه."

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
#, perl-brace-format
msgid ""
"{bold}sib:{end_bold} Mating between individuals that have at least one "
"parent in common. Generally between two individuals within the same plot."
msgstr ""
"{bold}تهجين بين أشقاء:{end_bold} تزاوج بين أفراد يشتركون في أحد الأبوين على "
"الأقل. ويكون عادة بين فردين في القطعة التجريبية نفسها."

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
#, perl-brace-format
msgid ""
"{bold}bulk:{end_bold} A group of plants (usually a related family) "
"pollinated by an individual plant."
msgstr ""
"{bold}تلقيح مجموعة:{end_bold} مجموعة من النباتات (عادة عائلة ذات صلة قرابة) "
"لُقّحت بنبات فردي."

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
#, perl-brace-format
msgid ""
"{bold}bulk selfed:{end_bold} A group of plants (usually a related family) "
"that are self pollinated (each individual selfed, not combined pollen)."
msgstr ""
"{bold}تلقيح ذاتي لمجموعة:{end_bold} مجموعة من النباتات (عادة عائلة ذات صلة "
"قرابة) لُقّحت ذاتياً (كل فرد على حدة، دون خلط حبوب اللقاح)."

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
#, perl-brace-format
msgid ""
"{bold}bulk and open pollinated:{end_bold} A group of plants (usually a "
"related family) that are pollinated by another group of plants or open "
"pollinated (pollen may be from a group with known or unknown members)."
msgstr ""
"{bold}تلقيح مجموعة ومفتوح:{end_bold} مجموعة من النباتات (عادة عائلة ذات صلة "
"قرابة) لُقّحت بمجموعة أخرى أو تلقيحاً حراً (قد تأتي حبوب اللقاح من مجموعة معروفة "
"الأفراد أو مجهولتهم)."

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
#, perl-brace-format
msgid ""
"{bold}doubled haploid:{end_bold} Plants derived from doubling the chromosome "
"number of haploid tissue."
msgstr ""
"{bold}أحادي الصيغة الصبغية المضاعف:{end_bold} نباتات ناتجة من مضاعفة عدد "
"كروموسومات نسيج أحادي الصيغة الصبغية."

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
#, perl-brace-format
msgid ""
"{bold}dihaploid induction:{end_bold} Plants derived from a chromosome "
"reduction from tetraploid to diploid"
msgstr ""
"{bold}استحداث ثنائي الصيغة الصبغية:{end_bold} نباتات ناتجة من اختزال عدد "
"الكروموسومات من رباعي إلى ثنائي الصيغة الصبغية"

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
msgid "Group of Crosses:"
msgstr "مجموعة التهجينات:"

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
#, perl-brace-format
msgid ""
"{bold}polycross:{end_bold} Creates a group of open pollinated crosses. Each "
"accession in the selected list becomes the female parent in an open cross, "
"and all the members of the list grouped together form the male parent."
msgstr ""
"{bold}تهجين متعدد الآباء:{end_bold} ينشئ مجموعة من التهجينات حرة التلقيح. "
"يصبح كل مدخل في القائمة المحددة أباً أنثوياً في تهجين مفتوح، وتشكل جميع مدخلات "
"القائمة مجتمعة الأب الذكري."

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
#, perl-brace-format
msgid ""
"{bold}reciprocal:{end_bold} Creates a group of biparental crosses. Starting "
"with a list of accessions, all possible biparental cross combinations are "
"made between them."
msgstr ""
"{bold}تهجين تبادلي:{end_bold} ينشئ مجموعة من التهجينات ثنائية الأبوين. "
"انطلاقاً من قائمة مدخلات، تُجرى جميع توليفات التهجين الثنائي الممكنة بينها."

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
#, perl-brace-format
msgid ""
"{bold}multicross:{end_bold} Creates a group of biparental crosses. Starting "
"with a list of maternal accessions and a list of paternal accessions, direct "
"crosses are made in order."
msgstr ""
"{bold}تهجين متعدد:{end_bold} ينشئ مجموعة من التهجينات ثنائية الأبوين. "
"انطلاقاً من قائمة مدخلات أمومية وقائمة مدخلات أبوية، تُجرى التهجينات المباشرة "
"بالترتيب."

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
msgid "The cross or crosses were saved successfully."
msgstr "حُفظ التهجين أو التهجينات بنجاح."

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
msgid "Please provide trial name"
msgstr "يُرجى إدخال اسم التجربة"

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
msgid "Please provide female parent name"
msgstr "يُرجى إدخال اسم الأصل الأمومي"

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
msgid "Please provide male parent name"
msgstr "يُرجى إدخال اسم الأصل الأبوي"

