#: mason/tools/tc_convert_deprecated.mas
msgid "Converting between SGN unigenes and TGI TC sequences"
msgstr "التحويل بين جينات SGN الفريدة وتسلسلات TGI TC"

#: mason/tools/tc_convert_deprecated.mas
#, perl-brace-format
msgid ""
"SGN and {link}the Gene Index Project (TGI){end_link}, now at {link2}"
"DFCI{end_link2}, maintain independent unigene/TC databases, entries in which "
"tend to have common member ESTs."
msgstr ""
"يحتفظ SGN و{link}مشروع فهرس الجينات (TGI){end_link}، الموجود الآن في {link2}"
"DFCI{end_link2}، بقاعدتي بيانات مستقلتين للجينات الفريدة/TC، وتميل مدخلاتهما "
"إلى مشاركة تسلسلات EST."

#: mason/tools/tc_convert_deprecated.mas
#, perl-brace-format
msgid ""
"SGN no longer maintains a specific tool for mapping between these two "
"databases. Instead, for users to establish correspondences between these two "
"sets, we recommend using the BLAST tools available on each of these sites."
msgstr ""
"لم يعد SGN يحتفظ بأداة مخصصة للربط بين قاعدتي البيانات هاتين. ولإيجاد "
"المطابقات بين المجموعتين، نوصي باستخدام أدوات BLAST المتاحة في كل من "
"الموقعين."

#: mason/tools/tc_convert_deprecated.mas
#, perl-brace-format
msgid ""
"Use the SGN-U sequences as input to the BLAST tool at {link}the TGI "
"site{end_link}."
msgstr "استخدم تسلسلات SGN-U كمدخلات لأداة BLAST في {link}موقع TGI{end_link}."

#: mason/tools/tc_convert_deprecated.mas
msgid "Mapping SGN-U to TGI TC"
msgstr "مطابقة SGN-U مع TGI TC"

#: mason/tools/tc_convert_deprecated.mas
#, perl-brace-format
msgid ""
"Use the TGI TC sequences as input to the {link}SGN BLAST tool{end_link}, "
"selecting one of the SGN unigene data sets."
