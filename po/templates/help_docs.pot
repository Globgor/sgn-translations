#: mason/help/datasets.mas:4
msgctxt "help.datasets.working_heading"
msgid "Working with Datasets"
msgstr ""

#. sections: help_docs
#: mason/help/datasets.mas:6
msgctxt "help.datasets.working_text"
msgid "Datasets are collections of identifiers that are stored in\nthe database. Datasets can be composed of accessions, plots, traits, locations,\nand trials. Datasets are attached to the individual user’s account, and can\nonly be created and seen by the user while logged in. SGN databases use \nDatasets in analysis tools on the website such as Wizard, GWAS, GS,\nHeritability, and Stability tools."
msgstr ""

