msgctxt "help.datasets.create_heading"
msgid "Creating Datasets"
msgstr ""

#. sections: help_docs
#: mason/help/datasets.mas:10
msgctxt "help.datasets.create_text"
msgid "Datasets are generated in the Wizard. Up to 4 identifiers\ncan be selected. First select the categories and entries in each column. In\nthis example we have selected Trials, Accessions, and Genotyping Protocols.\nThen enter a name in the “Create New Dataset” section. In this example we have\nused “Tinker QTL 2021”. After creating the dataset, you can make it public for\nothers to use by first selecting the dataset using the “Load Dataset”\nlist then selecting the “Make Public” button."
msgstr ""

#. sections: help_docs
#: mason/help/datasets.mas:26
msgctxt "help.datasets.publications_text"
msgid "Datasets can also be used in publications for linking available\ndata. Copy the URL from the detail page found in the Search Datasets\npage."
msgstr ""

#. sections: help_docs
#: mason/help/datasets.mas:14
msgctxt "help.datasets.retrieve_heading"
msgid "Retrieving Datasets"
msgstr ""

#. sections: help_docs
#: mason/help/datasets.mas:16
msgctxt "help.datasets.retrieve_text"
msgid "To retrieve a dataset in the Wizard, select the dataset in\nthe “Load Dataset” input then select the “Load” button. This will populate the\ncolumns in the Wizard and then allow you to download and analyze the dataset."
msgstr ""

#. sections: help_docs
#: mason/help/datasets.mas:19
msgctxt "help.datasets.search_heading"
msgid "Searching Datasets"
msgstr ""

#. sections: help_docs
#: mason/help/datasets.mas:21
msgctxt "help.datasets.search_text"
msgid "To search for a dataset, select the “Datasets” link in the\ntoolbar at the top right of the website. Selecting the Dataset name will\ngive you a Dataset Detail page"
msgstr ""

