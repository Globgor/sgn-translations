#. sections: collection_upload genotype_plates genotypes_markers trial_card trial_design
#: js/source/legacy/CXGN/BreedersToolbox/AddTrial.js:1115
msgctxt "trial.create.design.description.alpha"
msgid "Generates an Alpha design starting from design fixing under the 4 series formulated by Patterson and Williams. Creates plot entities in the database."
msgstr ""

#. sections: collection_upload genotype_plates genotypes_markers trial_card trial_design
#: js/source/legacy/CXGN/BreedersToolbox/AddTrial.js:1119
msgctxt "trial.create.design.description.augmented"
msgid "Generates an Augmented design. Some treatments (checks) are replicated r times and other treatments (new) are replicated once. Creates plot entities in the database."
msgstr ""

#. sections: collection_upload genotype_plates genotypes_markers trial_card trial_design
#: js/source/legacy/CXGN/BreedersToolbox/AddTrial.js:1105
msgctxt "trial.create.design.description.crd"
msgid "Generates a Completely Randomized design (CRD) with equal or different repetition, using the methods of random number generation in R. Creates plot entities in the database."
msgstr ""

#. sections: collection_upload genotype_plates genotypes_markers trial_card trial_design
#: js/source/legacy/CXGN/BreedersToolbox/AddTrial.js:1111
msgctxt "trial.create.design.description.drrc"
msgid "Generates a Doubly-Resolvable Row-Column design (DRRC), using the blocksdesign package in R. It creates complete blocks in columns and rows. The number of accessions must be divisible by the number of columns and rows."
msgstr ""

#. sections: collection_upload genotype_plates genotypes_markers trial_card trial_design
#: js/source/legacy/CXGN/BreedersToolbox/AddTrial.js:1123
msgctxt "trial.create.design.description.greenhouse"
msgid "A greenhouse/nursery houses plants in no particular layout design. The plants can be of named accessions or in the case of seedling nurseries from crosses, the plants can be of named crosses. Creates plot entities with plant entities in the database."
msgstr ""

#. sections: collection_upload genotype_plates genotypes_markers trial_card trial_design
#: js/source/legacy/CXGN/BreedersToolbox/AddTrial.js:1117
msgctxt "trial.create.design.description.lattice"
msgid "Generates SIMPLE and TRIPLE lattice designs using the design.lattice function from the agricolae R package. Randomizes treatments in K x K lattice. Creates plot entities in the database."
msgstr ""

#. sections: collection_upload genotype_plates genotypes_markers trial_card trial_design
#: js/source/legacy/CXGN/BreedersToolbox/AddTrial.js:1121
msgctxt "trial.create.design.description.mad"
msgid "Adjustments are calculated using data from all checks. Creates plot entities in the database."
msgstr ""

#. sections: collection_upload genotype_plates genotypes_markers trial_card trial_design
#: js/source/legacy/CXGN/BreedersToolbox/AddTrial.js:1127
msgctxt "trial.create.design.description.p_rep"
msgid "Has some treatments that are unreplicated and relies on replicated treatments to make the trial analysable. It is recommended that at least 20% of the experimental units are occupied by replicated treatments. Creates plot entities in the database."
msgstr ""

#. sections: collection_upload genotype_plates genotypes_markers trial_card trial_design
#: js/source/legacy/CXGN/BreedersToolbox/AddTrial.js:1107
msgctxt "trial.create.design.description.rcbd"
msgid "Generates a Randomized Complete Block design (RCBD), using the methods of random number generation in R. Creates plot entities in the database."
msgstr ""

#. sections: collection_upload genotype_plates genotypes_markers trial_card trial_design
#: js/source/legacy/CXGN/BreedersToolbox/AddTrial.js:1109
msgctxt "trial.create.design.description.rrc"
msgid "Generates a Resolvable Row-Column design (RRC), using the blocksdesign package in R. In addition to the one-way blocks it adds a constraint that no treatment may appear more than once in each row (latinization). Each row becomes an incomplete block."
msgstr ""

#. sections: collection_upload genotype_plates genotypes_markers trial_card trial_design
#: js/source/legacy/CXGN/BreedersToolbox/AddTrial.js:1125
msgctxt "trial.create.design.description.splitplot"
msgid "Split plot designs are useful for applying treatments to subplots of a plot. If you give two treatments with two levels each, there will be four subplots with the four treatment combinations distributed randomly among them. Creates plot entities with subplot entities with plant entities in the database."
msgstr ""

#. sections: collection_upload genotype_plates genotypes_markers trial_card trial_design
#: js/source/legacy/CXGN/BreedersToolbox/AddTrial.js:1113
msgctxt "trial.create.design.description.urdd"
msgid "Generates an Un-Replicated Diagonal Design (URDD), using the FieldHub package in R. It is an Un-Replicateddesign with an option to create blocks. All checks are distributed in diagonals."
msgstr ""

#. sections: collection_upload genotype_plates genotypes_markers trial_card trial_design
#: js/source/legacy/CXGN/BreedersToolbox/AddTrial.js:1129
msgctxt "trial.create.design.description.westcott"
msgid "Generates a fieldplan for an unreplicated design with genotypes randomly allocated within a field with checks following the method described by Westcott (1981)."
msgstr ""

