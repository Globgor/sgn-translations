#. sections: genotypes_markers
#: cgi-bin/markers/cos_markers.pl:20
msgctxt "genotype.marker.we_have_used_a_computational_method_to_screen_the_tomato_est_database"
msgid "We have used a computational method to screen the\n          tomato EST database against the arabidopsis genome\n          sequence in order to find a set of highly conserved,\n          single copy genes which can be used as markers for\n          comparative mapping between the tomato and arabidopsis\n          genomes. Currently we have identified approximately 1000\n          of these Conserved Ortholog Set (COS) markers."
msgstr ""

#. sections: genotypes_markers
#: cgi-bin/markers/index.pl:31
msgctxt "genotype.marker.while_microsatellites_or_simple_sequence_repeats_ssrs_normally_occur_in_non_coding"
msgid "- While microsatellites or simple sequence repeats (SSRs) normally occur in non-coding regions of the genome, they can also occur in either 3' or 5' UTRs of ESTs or even in coding regions (usually triplet repeats). See this page for more information."
msgstr ""

#. sections: genotypes_markers
#: cgi-bin/markers/microsats.pl:15
msgctxt "genotype.marker.while_microsatellites_or_simple_sequence_repeats_ssrs_normally_occur_in_non_coding_335baa"
msgid "While microsatellites or simple sequence repeats (SSRs)\n    normally occur in non-coding regions of the genome, they can\n    also occur in either 3' or 5' UTRs of ESTs or even in coding\n    regions (usually triplet repeats). For this reason, the tomato\n    and potato EST sequences contained in SGN were screened for\n    microsatellite sequence motifs in May 2001 using analytical\n    tools developed by Genomics Edge Technologies, Inc; St. Louis,\n    Missouri. The purpose was to identify SSRs that might be useful\n    a polymorphic molecular markers genetic and breeding studies in\n    tomato. The search parameters were for all possible repeat\n    motifs 2 bp to 6 bp with repeat blocks"
msgstr ""

#. sections: genotypes_markers
#: cgi-bin/markers/cosii_markers.pl:73
msgctxt "genotype.marker.wu_f_mueller_la_crouzillat_d_petiard_v_tanksley_sd_2006_combining"
msgid "Wu F, Mueller LA, Crouzillat D, Petiard V, Tanksley SD (2006).\nCombining Bioinformatics and Phylogenetics to Identify Large Sets of\nSingle Copy, Orthologous Genes (COSII) for Comparative, Evolutinonary\nand Systematics Studies: A Test Case in the Euasterid Plant Clade (2006).\nGenetics, 2006 Nov;174(3):1407-20."
msgstr ""

