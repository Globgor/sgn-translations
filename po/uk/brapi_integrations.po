msgstr "Відмовити в доступі"

#: mason/brapi/authorize.mas:22
msgctxt "integrations.consent.explanation"
msgid " through your account. Use the buttons below to authorize or deny this request."
msgstr " через ваш обліковий запис. Дозвольте або відхиліть цей запит кнопками нижче."

#: mason/brapi/authorize.mas:21
msgctxt "integrations.consent.hello"
msgid "Hello "
msgstr "Вітаємо, "

#: mason/brapi/authorize.mas:9
msgctxt "integrations.consent.title"
msgid "BrAPI Client Authorization"
msgstr "Авторизація клієнта BrAPI"

#: mason/authenticate/oidc/error.mas:13
msgctxt "integrations.oidc.callback_error"
msgid "Received error in the callback params. "
msgstr "Отримано помилку в параметрах відповіді сервісу входу. "

#: mason/authenticate/oidc/error.mas:34
msgctxt "integrations.oidc.client_id_missing"
msgid " The client ID is not configured for '%{provider}'."
msgstr " Ідентифікатор клієнта не налаштовано для '%{provider}'."

#: mason/authenticate/oidc/error.mas:30
msgctxt "integrations.oidc.configuration_url_missing"
msgid "The well known url is not configured for '%{provider}'."
msgstr "URL конфігурації не налаштовано для '%{provider}'."

#: mason/authenticate/oidc/error.mas:46
msgctxt "integrations.oidc.email_not_verified"
msgid "Your email is not verified with the external provider. Please verify your email with %{provider} first."
msgstr "Вашу електронну адресу не підтверджено в зовнішньому сервісі. Спочатку підтвердьте її в %{provider}."

#: mason/authenticate/oidc/error.mas:54
msgctxt "integrations.oidc.email_other_user"
msgid "The provided email '%{email}' is associated with a different user '%{other_username}'. Please contact your system administrator for more help."
msgstr "Електронна адреса '%{email}' пов’язана з іншим користувачем '%{other_username}'. Зверніться до адміністратора."

#: mason/authenticate/oidc/error.mas:58
msgctxt "integrations.oidc.email_user_missing"
msgid "No system user was found with the email '%{email}'. If you have not yet registered for an account, please do so first. Otherwise, please contact your system administrator."
msgstr "Користувача з електронною адресою '%{email}' не знайдено. Якщо ви ще не зареєструвалися, спочатку створіть обліковий запис. Інакше зверніться до адміністратора."

#: mason/authenticate/oidc/error.mas:16
msgctxt "integrations.oidc.fetch_certificate"
msgid "Failed to fetch provider's certificate. "
msgstr "Не вдалося отримати сертифікат сервісу входу. "

#: mason/authenticate/oidc/error.mas:10
msgctxt "integrations.oidc.fetch_configuration"
msgid "Failed to fetch well known url. "
msgstr "Не вдалося отримати конфігурацію сервісу входу. "

#: mason/authenticate/oidc/error.mas:19
msgctxt "integrations.oidc.fetch_token"
msgid "Failed to fetch access token. "
msgstr "Не вдалося отримати токен доступу. "

#: mason/authenticate/oidc/error.mas:22
msgctxt "integrations.oidc.fetch_userinfo"
msgid "Failed to fetch  userinfo. "
msgstr "Не вдалося отримати відомості про користувача. "

#: mason/authenticate/oidc/error.mas:62
msgctxt "integrations.oidc.mirror_site"
msgid "This site is a mirror site and does not support adding users. Please go to the main site to create an account."
msgstr "Це дзеркальний сайт, на якому не можна додавати користувачів. Щоб створити обліковий запис, перейдіть на основний сайт."

#: mason/authenticate/oidc/error.mas:50
msgctxt "integrations.oidc.multiple_email_users"
msgid "Multiple users were found to have the email: '%{email}'. Please contact your system administrator for more help."
msgstr "Знайдено кількох користувачів з електронною адресою '%{email}'. Зверніться до адміністратора."

#: mason/authenticate/oidc/error.mas:26
msgctxt "integrations.oidc.provider_not_configured"
msgid "The provider '%{provider}' is not configured for this instance."
msgstr "Сервіс входу '%{provider}' не налаштовано для цього сайту."

#: mason/authenticate/oidc/error.mas:42
msgctxt "integrations.oidc.state_mismatch"
msgid "The state returned by the provider does not match the initiating state. Please try to login again, or contact your system administrator for more help."
msgstr "Стан входу, повернутий сервісом, не збігається з початковим. Спробуйте увійти ще раз або зверніться до адміністратора."

#: mason/authenticate/oidc/error.mas:38
msgctxt "integrations.oidc.state_verifier_missing"
msgid "The state verifier could not be found. Please try to login again, or contact your system administrator."
msgstr "Не знайдено код перевірки стану входу. Спробуйте увійти ще раз або зверніться до адміністратора."

#: mason/authenticate/oidc/error.mas:66
msgctxt "integrations.oidc.username_short"
msgid "The username '%{username}' is too short. Username must be 7 or more characters."
msgstr "Ім’я користувача '%{username}' закоротке. Воно має містити щонайменше 7 символів."

#: mason/authenticate/oidc/error.mas:70
msgctxt "integrations.oidc.username_spaces"
msgid "The username '%{username}' contains spaces."
msgstr "Ім’я користувача '%{username}' містить пробіли."

#: mason/brapiclient/home.mas:28
msgctxt "integrations.settings.calls_panel"
msgid "Calls Testing"
msgstr "Перевірка викликів"

#: mason/brapiclient/home.mas:34
msgctxt "integrations.settings.local"
msgid "local"
msgstr "локальний"

#: mason/brapiclient/home.mas:32
msgctxt "integrations.settings.url_select"
msgid "URL Select"
msgstr "Вибір URL"
