msgid "Logout"
msgstr "Вийти"

#: mason/brapiclient/authentication.mas:14
msgctxt "integrations.auth.logout_heading"
msgid "Logout"
msgstr "Вихід"

#: mason/brapiclient/authentication.mas:51
msgctxt "integrations.auth.logout_success"
msgid "Successfully logged out!"
msgstr "Вихід виконано!"

#: mason/brapiclient/authentication.mas:10
msgctxt "integrations.auth.password_placeholder"
msgid "Password"
msgstr "Пароль"

#: mason/brapiclient/authentication.mas:9
msgctxt "integrations.auth.username_placeholder"
msgid "Your Username"
msgstr "Ваше ім’я користувача"

#: mason/brapi/authorize.mas:22
msgctxt "integrations.consent.access_request"
msgid " would like to access "
msgstr " бажає отримати доступ до "

#: mason/brapi/authorize.mas:23
msgctxt "integrations.consent.authorize"
msgid "Authorize Access"
msgstr "Дозволити доступ"

#: mason/brapi/authorize.mas:24
msgctxt "integrations.consent.deny"
