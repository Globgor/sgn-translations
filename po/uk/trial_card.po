msgstr "Записи рослин успішно створено."

#: mason/breeders_toolbox/trial/add_plants_per_plot.mas:228
msgctxt "trial.plants.template_description.plot"
msgid "This is for recording individual plants in a plot. The plant name will be saved as a concatenation of plot_name + _ + plant_index_number"
msgstr "Цей шаблон призначено для запису окремих рослин на ділянці. Назву рослини буде збережено як конкатенацію plot_name + _ + plant_index_number"

#: mason/breeders_toolbox/trial/add_plants_per_subplot.mas:227
