msgstr "Пароль закороткий. Він має містити щонайменше %{minimum} символів"

#: lib/SGN/Controller/AJAX/User.pm:485
msgctxt "account.server.password_updated"
msgid "The password was successfully updated."
msgstr "Пароль успішно оновлено."

#: lib/SGN/Controller/AJAX/User.pm:138
msgctxt "account.server.password_username"
msgid "Password must not be the same as your username."
msgstr "Пароль не може збігатися з ім’ям користувача."

#: lib/SGN/Controller/AJAX/User.pm:457
msgctxt "account.server.reset_confirm_mismatch"
msgid "Please enter the same password in the confirm password field!"
msgstr "Уведіть той самий пароль у полі підтвердження!"

#: lib/SGN/Controller/AJAX/User.pm:437
msgctxt "account.server.reset_requested"
msgid "Password reset email requested. If you have an account on this database with this email, you will receive a message with a password reset link.  If you do not have an account with this email address, you will not receive a message."
msgstr "Запит на скидання пароля надіслано. Якщо обліковий запис із цією адресою є в базі даних, ви отримаєте лист із посиланням для скидання. Якщо такого запису немає, лист не надходитиме."

#: lib/SGN/Controller/AJAX/User.pm:126
msgctxt "account.server.username_exists"
msgid "Username \"%{username}\" is already in use. Please pick a different username."
msgstr "Ім’я користувача «%{username}» вже використовується. Виберіть інше ім’я."

#: lib/SGN/Controller/AJAX/User.pm:117
msgctxt "account.server.username_short"
msgid "Username is too short. Username must be %{minimum} or more characters"
msgstr "Ім’я користувача закоротке. Воно має містити щонайменше %{minimum} символів"

#: lib/SGN/Controller/AJAX/User.pm:119
msgctxt "account.server.username_spaces"
