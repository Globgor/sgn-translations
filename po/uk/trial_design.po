msgstr "Рядок %{row}: значення %{field} %{value} некоректне.  Допустимі значення: порожнє поле (%{blank}), %{zero} (не контроль) або %{one} (контроль)."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:384
#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:392
#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:400
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialMetadataGeneric.pm:103
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialMetadataGeneric.pm:106
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialMetadataGeneric.pm:109
msgctxt "trial.upload.multi.generic.date_format"
msgid "Row %{row}: %{field} %{value} must be in the format %{date_format}."
msgstr "Рядок %{row}: %{field} %{value} потрібно вказати у форматі %{date_format}."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:895
msgctxt "trial.upload.multi.generic.entry_number_accessions_mismatch"
msgid "%{heading}: Entry number %{entry_number} has multiple accessions (%{accessions}) assigned to it in trial %{trial}."
msgstr "%{heading}: номеру входження %{entry_number} призначено кілька зразків (%{accessions}) у досліді %{trial}."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:880
msgctxt "trial.upload.multi.generic.entry_numbers_mismatch"
msgid "%{heading}: Accession %{accession} has multiple entry numbers (%{entry_numbers}) assigned to it in trial %{trial}."
msgstr "%{heading}: зразку %{accession} призначено кілька номерів входження (%{entry_numbers}) у досліді %{trial}."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:640
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialMetadataGeneric.pm:196
msgctxt "trial.upload.multi.generic.invalid_year"
msgid "%{field} %{year} is not a valid year, must be a %{digits} digit positive integer."
msgstr "%{field} %{year} — некоректний рік, потрібно додатне ціле число з %{digits} цифр."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:615
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialMetadataGeneric.pm:182
msgctxt "trial.upload.multi.generic.location_code_match"
msgid "File location %{code} matches the code for the location named %{location} and will be substituted if you ignore warnings."
msgstr "Код місця розташування у файлі %{code} відповідає коду місця %{location} і буде замінений, якщо проігнорувати попередження."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:629
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialMetadataGeneric.pm:190
msgctxt "trial.upload.multi.generic.locations_missing"
msgid "Location(s) %{locations} are not in the database."
msgstr "Місць розташування %{locations} немає в базі даних."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:756
msgctxt "trial.upload.multi.generic.multiple_accession_synonyms"
msgid "Accession(s) %{details} appear in the database as synonyms of more than one unique accession. Please change to the unique accession name or delete the multiple synonyms"
msgstr "Зразки %{details} у базі даних є синонімами кількох унікальних зразків. Замініть назву на унікальну або вилучіть повторні синоніми"

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:568
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:395
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialMetadataGeneric.pm:142
msgctxt "trial.upload.multi.generic.no_spaces"
msgid "%{field} %{value} must not contain spaces."
msgstr "У %{field} %{value} не має бути пробілів."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:340
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:221
msgctxt "trial.upload.multi.generic.no_spaces_row"
msgid "Row %{row}: %{field} %{value} must not contain spaces."
msgstr "Рядок %{row}: у %{field} %{value} не має бути пробілів."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:859
msgctxt "trial.upload.multi.generic.overlapping_position"
msgid "More than %{one} plot is assigned to the position %{position}"
msgstr "До місця %{position} призначено більше ніж %{one} ділянку"

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:842
msgctxt "trial.upload.multi.generic.plot_name_repeated"
msgid "Plot name %{plot_name} is used %{count} times. Each plot should have a unique plot name across all trials."
msgstr "Назву ділянки %{plot_name} використано %{count} разів. Кожна ділянка має мати унікальну назву серед усіх дослідів."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:348
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:229
msgctxt "trial.upload.multi.generic.plot_name_slashes_warning"
msgid "Row %{row}: %{field} %{value} contains slashes. Note that slashes can cause problems for third-party applications; however, plot names can be saved with slashes if you ignore warnings."
msgstr "Рядок %{row}: у %{field} %{value} є скісні риски. Вони можуть спричиняти проблеми в сторонніх застосунках; однак назви ділянок можна зберегти зі скісними рисками, якщо проігнорувати попередження."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:776
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:471
msgctxt "trial.upload.multi.generic.plot_names_already_used"
msgid "Plot name(s) %{names} are invalid because they are already used in the database."
msgstr "Назви ділянок %{names} некоректні, оскільки їх уже використано в базі даних."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:828
msgctxt "trial.upload.multi.generic.plot_number_repeated"
msgid "Plot number %{plot_number} in trial %{trial} is used %{count} times.  Each plot should have a unique plot number in an individual trial."
msgstr "Номер ділянки %{plot_number} у досліді %{trial} використано %{count} разів.  Номер ділянки має бути унікальним у межах окремого досліду."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:310
#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:320
#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:330
#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:420
#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:428
#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:436
#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:454
#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:462
#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:481
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:191
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:201
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:211
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:275
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:283
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:291
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:305
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:313
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:332
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialSpatialLayoutGeneric.pm:72
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialSpatialLayoutGeneric.pm:77
msgctxt "trial.upload.multi.generic.positive_integer"
msgid "Row %{row}: %{field} %{value} must be a positive integer."
msgstr "Рядок %{row}: %{field} %{value} має бути додатним цілим числом."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:358
#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:366
#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:374
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:239
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:247
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:255
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialMetadataGeneric.pm:114
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialMetadataGeneric.pm:117
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialMetadataGeneric.pm:120
msgctxt "trial.upload.multi.generic.positive_number"
msgid "Row %{row}: %{field} %{value} must be a positive number."
msgstr "Рядок %{row}: %{field} %{value} має бути додатним числом."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:599
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialMetadataGeneric.pm:156
msgctxt "trial.upload.multi.generic.programs_missing"
msgid "Breeding program(s) %{programs} are not in the database."
msgstr "Селекційних програм %{programs} немає в базі даних."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:470
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:321
msgctxt "trial.upload.multi.generic.seedlot_no_seed_quantity"
msgid "Row %{row}: this plot does not have a count or weight of seed to be used from seedlot %{seedlot}."
msgstr "Рядок %{row}: для цієї ділянки не вказано кількість чи масу насіння, яке потрібно взяти з насіннєвої партії %{seedlot}."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:788
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:442
msgctxt "trial.upload.multi.generic.seedlots_missing"
msgid "Seedlot(s) %{seedlots} are not in the database.  To use a seedlot as a seed source for a plot, the seedlot must already exist in the database."
msgstr "Насіннєвих партій %{seedlots} немає в базі даних.  Щоб використати насіннєву партію як джерело насіння для ділянки, вона вже має існувати в базі даних."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:576
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:403
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialMetadataGeneric.pm:145
msgctxt "trial.upload.multi.generic.slashes_warning"
msgid "%{field} %{value} contains slashes. Note that slashes can cause problems for third-party applications; however, trial names can be saved with slashes if you ignore warnings."
msgstr "У %{field} %{value} є скісні риски. Вони можуть спричиняти проблеми в сторонніх застосунках; однак назви дослідів можна зберегти зі скісними рисками, якщо проігнорувати попередження."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:741
msgctxt "trial.upload.multi.generic.stocks_missing"
msgid "Stocks(s) %{stocks} are not in the database as %{name_type} or synonyms of %{stock_type} stock type."
msgstr "Матеріал(и) %{stocks} відсутні в базі даних як %{name_type} або синоніми матеріалу типу %{stock_type}."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:719
#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:730
msgctxt "trial.upload.multi.generic.stocks_wrong_type"
msgid "Stocks(s) %{stocks} are not in the database or are not %{stock_type_one} or %{stock_type_two} stock type."
msgstr "Матеріал(и) %{stocks} відсутні в базі даних або мають бути матеріалом типу %{stock_type_one} чи %{stock_type_two}."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:176
msgctxt "trial.upload.multi.generic.template_must_match"
msgid "Trial %{trial}: %{template_key} must be the same value on every row of a trial. Found %{values}."
msgstr "У всіх рядках досліду %{trial} значення %{template_key} має бути однаковим. Знайдено: %{values}."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:166
msgctxt "trial.upload.multi.generic.template_required_all_rows"
msgid "Trial %{trial}: %{template_key} must be provided on every row of a trial if it is used for any row of that trial."
msgstr "Для досліду %{trial} потрібно вказати %{template_key} у кожному рядку, якщо цей параметр використовується хоча б в одному рядку досліду."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:202
msgctxt "trial.upload.multi.generic.template_wrong_program"
msgid "Trial %{trial}: %{template_key} %{template_name} does not belong to breeding program %{program}."
msgstr "Шаблон %{template_key} %{template_name} для досліду %{trial} не належить селекційній програмі %{program}."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:105
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:74
msgctxt "trial.upload.multi.generic.treatment_column_format"
msgid "Column %{column} is not formatted like a treatment. Use only full, valid treatment names.\n"
msgstr "Стовпець %{column} має неправильний формат обробки. Використовуйте лише повні коректні назви обробок.\n"

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:116
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:85
msgctxt "trial.upload.multi.generic.treatment_missing"
msgid "Treatment %{treatment} does not exist in the database.\n"
msgstr "Обробки %{treatment} немає в базі даних.\n"

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:287
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:167
msgctxt "trial.upload.multi.generic.treatment_value_above_maximum"
msgid "Row %{row}: value for %{treatment} is higher than the allowed maximum for that treatment."
msgstr "Рядок %{row}: значення для обробки %{treatment} вище за дозволений максимум."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:279
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:159
msgctxt "trial.upload.multi.generic.treatment_value_below_minimum"
msgid "Row %{row}: value for %{treatment} is lower than the allowed minimum for that treatment."
msgstr "Рядок %{row}: значення для обробки %{treatment} нижче за дозволений мінімум."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:298
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:178
msgctxt "trial.upload.multi.generic.treatment_value_category"
msgid "Row %{row}: value for %{treatment} is not in the valid categories for that treatment."
msgstr "Рядок %{row}: значення для обробки %{treatment} не належить до допустимих категорій."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:586
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:410
msgctxt "trial.upload.multi.generic.trial_names_already_used"
msgid "Trial name(s) %{names} are invalid because they are already used in the database."
msgstr "Назви дослідів %{names} некоректні, оскільки їх уже використано в базі даних."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:653
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialMetadataGeneric.pm:203
msgctxt "trial.upload.multi.generic.unsupported_design_type"
msgid "%{field} %{value} is not supported. Supported design types: %{supported_types}."
msgstr "%{field} %{value} не підтримується. Підтримувані типи схеми: %{supported_types}."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:679
msgctxt "trial.upload.multi.generic.unsupported_stock_type"
msgid "%{field} %{value} is not supported. Supported trial stock types: %{supported_types}."
msgstr "%{field} %{value} не підтримується. Підтримувані типи матеріалу для досліду: %{supported_types}."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:666
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialMetadataGeneric.pm:210
msgctxt "trial.upload.multi.generic.unsupported_trial_type"
msgid "%{field} %{value} is not supported. Supported trial types: %{supported_types}."
msgstr "%{field} %{value} не підтримується. Підтримувані типи досліду: %{supported_types}."
