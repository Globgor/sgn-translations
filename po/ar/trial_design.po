msgctxt "trial.upload.multi.generic.positive_number"
msgid "Row %{row}: %{field} %{value} must be a positive number."
msgstr "الصف %{row}: يجب أن يكون %{field} %{value} عددًا موجبًا."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:599
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialMetadataGeneric.pm:156
msgctxt "trial.upload.multi.generic.programs_missing"
msgid "Breeding program(s) %{programs} are not in the database."
msgstr "برامج التربية %{programs} غير موجودة في قاعدة البيانات."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:470
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:321
msgctxt "trial.upload.multi.generic.seedlot_no_seed_quantity"
msgid "Row %{row}: this plot does not have a count or weight of seed to be used from seedlot %{seedlot}."
msgstr "الصف %{row}: لا تحتوي هذه القطعة على عدد أو وزن بذور لاستخدامه من دفعة البذور %{seedlot}."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:788
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:442
msgctxt "trial.upload.multi.generic.seedlots_missing"
msgid "Seedlot(s) %{seedlots} are not in the database.  To use a seedlot as a seed source for a plot, the seedlot must already exist in the database."
msgstr "دفعات البذور %{seedlots} غير موجودة في قاعدة البيانات.  لاستخدام دفعة كمصدر بذور للقطعة، يجب أن تكون الدفعة موجودة في قاعدة البيانات بالفعل."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:576
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:403
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialMetadataGeneric.pm:145
msgctxt "trial.upload.multi.generic.slashes_warning"
msgid "%{field} %{value} contains slashes. Note that slashes can cause problems for third-party applications; however, trial names can be saved with slashes if you ignore warnings."
msgstr "يحتوي %{field} %{value} على شرطات مائلة. قد تسبب مشكلات في تطبيقات الجهات الخارجية، لكن يمكن حفظ أسماء التجارب مع الشرطات المائلة إذا تجاهلت التحذيرات."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:741
msgctxt "trial.upload.multi.generic.stocks_missing"
msgid "Stocks(s) %{stocks} are not in the database as %{name_type} or synonyms of %{stock_type} stock type."
msgstr "المواد %{stocks} غير موجودة في قاعدة البيانات كـ %{name_type} أو كمرادفات لمواد من النوع %{stock_type}."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:719
#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:730
msgctxt "trial.upload.multi.generic.stocks_wrong_type"
msgid "Stocks(s) %{stocks} are not in the database or are not %{stock_type_one} or %{stock_type_two} stock type."
msgstr "المواد %{stocks} غير موجودة في قاعدة البيانات أو ليست من النوع %{stock_type_one} أو %{stock_type_two}."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:176
msgctxt "trial.upload.multi.generic.template_must_match"
msgid "Trial %{trial}: %{template_key} must be the same value on every row of a trial. Found %{values}."
msgstr "يجب أن تكون قيمة %{template_key} متطابقة في جميع صفوف التجربة %{trial}. القيم الموجودة: %{values}."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:166
msgctxt "trial.upload.multi.generic.template_required_all_rows"
msgid "Trial %{trial}: %{template_key} must be provided on every row of a trial if it is used for any row of that trial."
msgstr "يجب توفير %{template_key} للتجربة %{trial} في كل صف إذا استُخدم في أي صف من التجربة."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:202
msgctxt "trial.upload.multi.generic.template_wrong_program"
msgid "Trial %{trial}: %{template_key} %{template_name} does not belong to breeding program %{program}."
msgstr "القالب %{template_key} %{template_name} للتجربة %{trial} لا يتبع برنامج التربية %{program}."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:105
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:74
msgctxt "trial.upload.multi.generic.treatment_column_format"
msgid "Column %{column} is not formatted like a treatment. Use only full, valid treatment names.\n"
msgstr "تنسيق العمود %{column} ليس تنسيق معاملة. استخدم أسماء المعاملات الكاملة والصحيحة فقط.\n"

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:116
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:85
msgctxt "trial.upload.multi.generic.treatment_missing"
msgid "Treatment %{treatment} does not exist in the database.\n"
msgstr "المعاملة %{treatment} غير موجودة في قاعدة البيانات.\n"

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:287
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:167
msgctxt "trial.upload.multi.generic.treatment_value_above_maximum"
msgid "Row %{row}: value for %{treatment} is higher than the allowed maximum for that treatment."
msgstr "الصف %{row}: قيمة المعاملة %{treatment} أعلى من الحد الأقصى المسموح به لهذه المعاملة."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:279
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:159
msgctxt "trial.upload.multi.generic.treatment_value_below_minimum"
msgid "Row %{row}: value for %{treatment} is lower than the allowed minimum for that treatment."
msgstr "الصف %{row}: قيمة المعاملة %{treatment} أقل من الحد الأدنى المسموح به لهذه المعاملة."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:298
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:178
msgctxt "trial.upload.multi.generic.treatment_value_category"
msgid "Row %{row}: value for %{treatment} is not in the valid categories for that treatment."
msgstr "الصف %{row}: قيمة المعاملة %{treatment} ليست ضمن الفئات الصالحة لهذه المعاملة."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:586
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:410
msgctxt "trial.upload.multi.generic.trial_names_already_used"
msgid "Trial name(s) %{names} are invalid because they are already used in the database."
msgstr "أسماء التجارب %{names} غير صالحة لأنها مستخدمة بالفعل في قاعدة البيانات."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:653
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialMetadataGeneric.pm:203
msgctxt "trial.upload.multi.generic.unsupported_design_type"
msgid "%{field} %{value} is not supported. Supported design types: %{supported_types}."
msgstr "%{field} %{value} غير مدعوم. أنواع التصميم المدعومة: %{supported_types}."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:679
msgctxt "trial.upload.multi.generic.unsupported_stock_type"
msgid "%{field} %{value} is not supported. Supported trial stock types: %{supported_types}."
msgstr "%{field} %{value} غير مدعوم. أنواع المواد المدعومة للتجربة: %{supported_types}."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:666
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialMetadataGeneric.pm:210
msgctxt "trial.upload.multi.generic.unsupported_trial_type"
msgid "%{field} %{value} is not supported. Supported trial types: %{supported_types}."
msgstr "%{field} %{value} غير مدعوم. أنواع التجارب المدعومة: %{supported_types}."
