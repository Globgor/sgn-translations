msgctxt "trial.upload.multi.generic.control_value_invalid"
msgid "Row %{row}: %{field} value of %{value} is invalid.  It must be %{blank} (not a control), %{zero} (not a control), or %{one} (is a control)."
msgstr "الصف %{row}: قيمة %{field} %{value} غير صالحة.  يجب أن تكون فارغة (%{blank}) أو %{zero} (ليست شاهدة) أو %{one} (شاهدة)."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:384
#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:392
#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:400
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialMetadataGeneric.pm:103
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialMetadataGeneric.pm:106
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialMetadataGeneric.pm:109
msgctxt "trial.upload.multi.generic.date_format"
msgid "Row %{row}: %{field} %{value} must be in the format %{date_format}."
msgstr "الصف %{row}: يجب أن يكون %{field} %{value} بالتنسيق %{date_format}."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:895
msgctxt "trial.upload.multi.generic.entry_number_accessions_mismatch"
msgid "%{heading}: Entry number %{entry_number} has multiple accessions (%{accessions}) assigned to it in trial %{trial}."
msgstr "%{heading}: مُعيّنة لرقم المدخل %{entry_number} عدة مدخلات (%{accessions}) في التجربة %{trial}."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:880
msgctxt "trial.upload.multi.generic.entry_numbers_mismatch"
msgid "%{heading}: Accession %{accession} has multiple entry numbers (%{entry_numbers}) assigned to it in trial %{trial}."
msgstr "%{heading}: مُعيّنة للمدخل %{accession} أرقام مدخل متعددة (%{entry_numbers}) في التجربة %{trial}."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:640
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialMetadataGeneric.pm:196
msgctxt "trial.upload.multi.generic.invalid_year"
msgid "%{field} %{year} is not a valid year, must be a %{digits} digit positive integer."
msgstr "%{field} %{year} سنة غير صالحة؛ يجب أن تكون عددًا صحيحًا موجبًا من %{digits} أرقام."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:615
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialMetadataGeneric.pm:182
msgctxt "trial.upload.multi.generic.location_code_match"
msgid "File location %{code} matches the code for the location named %{location} and will be substituted if you ignore warnings."
msgstr "رمز الموقع %{code} في الملف يطابق رمز الموقع %{location} وسيُستبدل إذا تجاهلت التحذيرات."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:629
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialMetadataGeneric.pm:190
msgctxt "trial.upload.multi.generic.locations_missing"
msgid "Location(s) %{locations} are not in the database."
msgstr "المواقع %{locations} غير موجودة في قاعدة البيانات."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:756
msgctxt "trial.upload.multi.generic.multiple_accession_synonyms"
msgid "Accession(s) %{details} appear in the database as synonyms of more than one unique accession. Please change to the unique accession name or delete the multiple synonyms"
msgstr "تظهر المدخلات %{details} في قاعدة البيانات كمرادفات لأكثر من مدخل فريد. غيّر الاسم إلى الاسم الفريد أو احذف المرادفات المتعددة"

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:568
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:395
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialMetadataGeneric.pm:142
msgctxt "trial.upload.multi.generic.no_spaces"
msgid "%{field} %{value} must not contain spaces."
msgstr "يجب ألا يحتوي %{field} %{value} على مسافات."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:340
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:221
msgctxt "trial.upload.multi.generic.no_spaces_row"
msgid "Row %{row}: %{field} %{value} must not contain spaces."
msgstr "الصف %{row}: يجب ألا يحتوي %{field} %{value} على مسافات."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:859
msgctxt "trial.upload.multi.generic.overlapping_position"
msgid "More than %{one} plot is assigned to the position %{position}"
msgstr "تم تعيين أكثر من %{one} قطعة إلى الموضع %{position}"

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:842
msgctxt "trial.upload.multi.generic.plot_name_repeated"
msgid "Plot name %{plot_name} is used %{count} times. Each plot should have a unique plot name across all trials."
msgstr "استُخدم اسم القطعة %{plot_name} %{count} مرة. يجب أن يكون لكل قطعة اسم فريد عبر جميع التجارب."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:348
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:229
msgctxt "trial.upload.multi.generic.plot_name_slashes_warning"
msgid "Row %{row}: %{field} %{value} contains slashes. Note that slashes can cause problems for third-party applications; however, plot names can be saved with slashes if you ignore warnings."
msgstr "الصف %{row}: يحتوي %{field} %{value} على شرطات مائلة. قد تسبب مشكلات في تطبيقات الجهات الخارجية، لكن يمكن حفظ أسماء القطع مع الشرطات المائلة إذا تجاهلت التحذيرات."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:776
#: lib/CXGN/Trial/ParseUpload/Plugin/TrialGeneric.pm:471
msgctxt "trial.upload.multi.generic.plot_names_already_used"
msgid "Plot name(s) %{names} are invalid because they are already used in the database."
msgstr "أسماء القطع %{names} غير صالحة لأنها مستخدمة بالفعل في قاعدة البيانات."

#: lib/CXGN/Trial/ParseUpload/Plugin/MultipleTrialDesignGeneric.pm:828
msgctxt "trial.upload.multi.generic.plot_number_repeated"
msgid "Plot number %{plot_number} in trial %{trial} is used %{count} times.  Each plot should have a unique plot number in an individual trial."
msgstr "استُخدم رقم القطعة %{plot_number} في التجربة %{trial} %{count} مرة.  يجب أن يكون لكل قطعة رقم فريد داخل التجربة."

