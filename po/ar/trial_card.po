#: mason/breeders_toolbox/trial/add_plants_per_plot.mas:38
msgctxt "trial.plant_coordinates.help.plot"
msgid "One plant per (row,column) coordinate. Rows and columns will be populated in a Cartesian pattern. Row and column numbers start at 1 within each plot. If adding additional plants, there must be enough spaces to accommodate both the previous plants and the new plants."
msgstr "نبات واحد لكل إحداثي (صف، عمود). تُملأ الصفوف والأعمدة بنمط ديكارتي، وتبدأ الأرقام من 1 داخل كل قطعة. عند إضافة نباتات أخرى، يجب توفر أماكن كافية للنباتات السابقة والجديدة."

#: mason/breeders_toolbox/trial/add_plants_per_subplot.mas:38
msgctxt "trial.plant_coordinates.help.subplot"
msgid "One plant per (row,column) coordinate. Rows and columns will be populated in a Cartesian pattern. Row and column numbers start at 1 within each subplot. If adding additional plants, there must be enough spaces to accommodate both the previous plants and the new plants."
msgstr "نبات واحد لكل إحداثي (صف، عمود). تُملأ الصفوف والأعمدة بنمط ديكارتي، وتبدأ الأرقام من 1 داخل كل قطعة فرعية. عند إضافة نباتات أخرى، يجب توفر أماكن كافية للنباتات السابقة والجديدة."

#: mason/breeders_toolbox/trial/add_plants_per_plot.mas:34
msgctxt "trial.plant_coordinates.plot"
msgid "Assign row and column data to plants within plots?"
msgstr "هل تريد إسناد بيانات الصف والعمود إلى النباتات داخل القطع؟"

#: mason/breeders_toolbox/trial/add_plants_per_subplot.mas:34
msgctxt "trial.plant_coordinates.subplot"
msgid "Assign row and column data to plants within plots?"
msgstr "هل تريد إسناد بيانات الصف والعمود إلى النباتات داخل القطع الفرعية؟"

#: mason/breeders_toolbox/trial/add_plants_per_plot.mas:349
msgctxt "trial.plant_plot.count_required_full"
msgid "- num_plants_per_plot (must be a number. the number of plants in the plot. the saved plant name will be a concatenation of plot_name + plant_number, such as MyTrial_plot101_plant1)"
msgstr "- num_plants_per_plot (يجب أن يكون رقمًا. عدد النباتات في القطعة. يُحفظ اسم النبات بدمج plot_name + plant_number، مثل MyTrial_plot101_plant1)"

#: mason/breeders_toolbox/trial/add_plants_per_plot.mas:326
msgctxt "trial.plant_plot.index_count_full"
msgid "The plant name will be saved as a concatenation of plot_name + _ + plant_index_number for as many plants as specified by num_plants_per_plot"
msgstr "سيُحفظ اسم النبات بدمج plot_name + _ + plant_index_number لعدد النباتات المحدد في num_plants_per_plot"

#: mason/breeders_toolbox/trial/add_plants_per_plot.mas:251
msgctxt "trial.plant_plot.index_required_full"
msgid "- plant_index_number (must be a number. the saved plant name will be a concatenation of plot_name + plant_index_number, such as MyTrial_plot101_plant1.)"
msgstr "- plant_index_number (يجب أن يكون رقمًا. يُحفظ اسم النبات بدمج plot_name + plant_index_number، مثل MyTrial_plot101_plant1.)"

#: mason/breeders_toolbox/trial/add_plants_per_plot.mas:357
msgctxt "trial.plant_plot.row_col_capacity"
msgid "The number of spaces given by the rows and columns should be greater than or equal to the num_plants_per_plot. Plants will be assigned rows and columns in zigzag pattern, starting from (1,1)."
msgstr "يجب أن يكون عدد المواقع الذي تحدده الصفوف والأعمدة مساويًا لـ num_plants_per_plot أو أكبر. ستُسند النباتات بنمط متعرج بدءًا من (1,1)."

#: mason/breeders_toolbox/trial/add_plants_per_subplot.mas:348
msgctxt "trial.plant_subplot.count_required_full"
msgid "num_plants_per_subplot (must be a number. the number of plants in the subplot. the saved plant name will be a concatenation of subplot_name + plant_number, such as MyTrial_plot101_subplot1_plant1)"
msgstr "num_plants_per_subplot (يجب أن يكون رقمًا. عدد النباتات في القطعة الفرعية. يُحفظ اسم النبات بدمج subplot_name + plant_number، مثل MyTrial_plot101_subplot1_plant1)"

#: mason/breeders_toolbox/trial/add_plants_per_subplot.mas:325
msgctxt "trial.plant_subplot.index_count_full"
msgid "The plant name will be saved as a concatenation of subplot_name + _ + plant_index_number for as many plants as specified by num_plants_per_subplot"
msgstr "سيُحفظ اسم النبات بدمج subplot_name + _ + plant_index_number لعدد النباتات المحدد في num_plants_per_subplot"

#: mason/breeders_toolbox/trial/add_plants_per_subplot.mas:250
msgctxt "trial.plant_subplot.index_required_full"
msgid "plant_index_number (must be a number. the saved plant name will be a concatenation of subplot_name + plant_index_number, such as MyTrial_plot101_subplot1_plant1.)"
msgstr "plant_index_number (يجب أن يكون رقمًا. يُحفظ اسم النبات بدمج subplot_name + plant_index_number، مثل MyTrial_plot101_subplot1_plant1.)"

#: mason/breeders_toolbox/trial/add_plants_per_subplot.mas:356
msgctxt "trial.plant_subplot.row_col_capacity"
msgid "The number of spaces given by the rows and columns should be greater than or equal to the num_plants_per_subplot. Plants will be assigned rows and columns in zigzag pattern, starting from (1,1)."
msgstr "يجب أن يكون عدد المواقع الذي تحدده الصفوف والأعمدة مساويًا لـ num_plants_per_subplot أو أكبر. ستُسند النباتات بنمط متعرج بدءًا من (1,1)."

