#: lib/SGN/Controller/AJAX/User.pm:252
msgctxt "account.server.account_created"
msgid ""
"Account was created with username \"%{username}\".\n"
"\n"
"%{confirmation}\n"
"\n"
"You will be able to login once your account has been confirmed."
msgstr ""
"تم إنشاء الحساب باسم المستخدم \"%{username}\".\n"
"\n"
"%{confirmation}\n"
"\n"
"ستتمكن من تسجيل الدخول بعد تأكيد الحساب."

#: lib/SGN/Controller/AJAX/User.pm:242
msgctxt "account.server.admin_confirmation"
msgid "Your account has been created but first must be confirmed by the site administrators.  You will receive an email once your account has been confirmed."
msgstr "تم إنشاء حسابك ويجب أن يؤكده مسؤولو الموقع أولاً. ستتلقى رسالة بريد إلكتروني عند تأكيده."

#: lib/SGN/Controller/AJAX/User.pm:157
msgctxt "account.server.creation_failed"
msgid "Account creation failed for the following reason(s): %{reasons}"
msgstr "تعذر إنشاء الحساب للأسباب التالية: %{reasons}"

#: lib/SGN/Controller/AJAX/User.pm:43
msgctxt "account.server.disabled_account"
msgid "This account has been deactivated due to %{reason}. Please contact the database administrator to re-instate the account."
msgstr "تم تعطيل هذا الحساب بسبب %{reason}. تواصل مع مسؤول قاعدة البيانات لإعادة تفعيله."

#: lib/SGN/Controller/AJAX/User.pm:248
msgctxt "account.server.email_confirmation"
msgid "To continue, you must confirm that we can reach you via email address \"%{email}\". An email has been sent with a URL to confirm this address. Please check your email for this message and use the link to confirm your email address."
msgstr "للمتابعة، أكد عنوان البريد الإلكتروني \"%{email}\". أُرسلت رسالة تحتوي على رابط التأكيد. تحقق من بريدك واستخدم الرابط لتأكيد العنوان."

#: lib/SGN/Controller/AJAX/User.pm:146
msgctxt "account.server.email_exists"
msgid "Email address is already associated with an account."
msgstr "عنوان البريد الإلكتروني هذا مرتبط بحساب بالفعل."

#: lib/SGN/Controller/AJAX/User.pm:141
msgctxt "account.server.email_invalid"
msgid "Email address is invalid."
msgstr "عنوان البريد الإلكتروني غير صالح."

#: lib/SGN/Controller/AJAX/User.pm:150
msgctxt "account.server.first_name_required"
msgid "You must enter a first name or initial."
msgstr "أدخل الاسم الأول أو الحرف الأول منه."

#: lib/SGN/Controller/AJAX/User.pm:412
msgctxt "account.server.forgot_requested"
msgid "Username email requested. If you have an account on this database with this email, you will receive a message that includes the username associated with this email address.  If you do not have an account with this email address, you will not receive a message."
msgstr "تم طلب رسالة تذكير باسم المستخدم. إذا كان لديك حساب بهذا البريد في قاعدة البيانات، فستتلقى رسالة تتضمن اسم المستخدم المرتبط به. إذا لم يوجد حساب بهذا البريد، فلن تتلقى رسالة."

#: lib/SGN/Controller/AJAX/User.pm:39
msgctxt "account.server.incorrect_credentials"
msgid "Login credentials are incorrect. Please try again."
msgstr "بيانات تسجيل الدخول غير صحيحة. حاول مرة أخرى."

#: lib/SGN/Controller/User.pm:141
msgctxt "account.server.invalid_reset_link"
msgid "The provided password reset link is invalid. Please try again with another link."
msgstr "رابط إعادة تعيين كلمة المرور غير صالح. حاول باستخدام رابط آخر."

#: lib/SGN/Controller/AJAX/User.pm:153
msgctxt "account.server.last_name_required"
msgid "You must enter a last name."
msgstr "أدخل اسم العائلة."

#: lib/SGN/Controller/AJAX/User.pm:48
msgctxt "account.server.login_success"
msgid "Login successful"
msgstr "تم تسجيل الدخول بنجاح"

#: lib/SGN/Controller/AJAX/User.pm:61 lib/SGN/Controller/AJAX/User.pm:75
msgctxt "account.server.logout_success"
msgid "User successfully logged out."
msgstr "تم تسجيل الخروج بنجاح."

#: lib/SGN/Controller/AJAX/User.pm:90
msgctxt "account.server.mirror_registration"
msgid "This site is a mirror site and does not support adding users. Please go to the main site to create an account."
msgstr "هذا الموقع مرآة ولا يدعم إضافة المستخدمين. انتقل إلى الموقع الرئيسي لإنشاء حساب."

