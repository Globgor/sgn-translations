#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
msgid "Individual Crosses:"
msgstr "Cruzamientos individuales:"

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
#, perl-brace-format
msgid ""
"{bold}biparental:{end_bold} An individual plant pollinated by another "
"individual plant."
msgstr ""
"{bold}biparental:{end_bold} Una planta individual polinizada por otra planta "
"individual."

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
#, perl-brace-format
msgid "{bold}self:{end_bold} A self pollinated individual plant."
msgstr ""
"{bold}autopolinización:{end_bold} Una planta individual autopolinizada."

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
#, perl-brace-format
msgid ""
"{bold}open pollinated:{end_bold} An individual plant pollinated by a group "
"of plants or open pollinated (pollen may be from a group with known or "
"unknown members)."
msgstr ""
"{bold}polinización abierta:{end_bold} Una planta individual polinizada por "
"un grupo de plantas o por polinización abierta (el polen puede proceder de "
"un grupo de miembros conocidos o desconocidos)."

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
#, perl-brace-format
msgid ""
"{bold}backcross:{end_bold} An individual plant pollinated by one of its "
"parents."
msgstr ""
"{bold}retrocruzamiento:{end_bold} Una planta individual polinizada por uno "
"de sus progenitores."

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
#, perl-brace-format
msgid ""
"{bold}sib:{end_bold} Mating between individuals that have at least one "
"parent in common. Generally between two individuals within the same plot."
msgstr ""
"{bold}cruce entre hermanos:{end_bold} Cruzamiento entre individuos que "
"tienen al menos un progenitor en común. Generalmente entre dos individuos de "
"la misma parcela."

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
#, perl-brace-format
msgid ""
"{bold}bulk:{end_bold} A group of plants (usually a related family) "
"pollinated by an individual plant."
msgstr ""
"{bold}cruzamiento de una población:{end_bold} Un grupo de plantas "
"(generalmente una familia emparentada) polinizado por una planta individual."

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
#, perl-brace-format
msgid ""
"{bold}bulk selfed:{end_bold} A group of plants (usually a related family) "
"that are self pollinated (each individual selfed, not combined pollen)."
msgstr ""
"{bold}autopolinización de una población:{end_bold} Un grupo de plantas "
"(generalmente una familia emparentada) autopolinizadas (cada individuo se "
"autopoliniza, sin mezclar el polen)."

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
#, perl-brace-format
msgid ""
"{bold}bulk and open pollinated:{end_bold} A group of plants (usually a "
"related family) that are pollinated by another group of plants or open "
"pollinated (pollen may be from a group with known or unknown members)."
msgstr ""
"{bold}cruzamiento poblacional y polinización abierta:{end_bold} Un grupo de "
"plantas (generalmente una familia emparentada) polinizado por otro grupo de "
"plantas o por polinización abierta (el polen puede proceder de un grupo de "
"miembros conocidos o desconocidos)."

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
#, perl-brace-format
msgid ""
"{bold}doubled haploid:{end_bold} Plants derived from doubling the chromosome "
"number of haploid tissue."
msgstr ""
"{bold}haploide duplicado:{end_bold} Plantas obtenidas mediante la "
"duplicación del número de cromosomas de tejido haploide."

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
#, perl-brace-format
msgid ""
"{bold}dihaploid induction:{end_bold} Plants derived from a chromosome "
"reduction from tetraploid to diploid"
msgstr ""
"{bold}inducción de dihaploides:{end_bold} Plantas obtenidas mediante una "
"reducción cromosómica de tetraploide a diploide"

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
msgid "Group of Crosses:"
msgstr "Grupo de cruzamientos:"

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
#, perl-brace-format
msgid ""
"{bold}polycross:{end_bold} Creates a group of open pollinated crosses. Each "
"accession in the selected list becomes the female parent in an open cross, "
"and all the members of the list grouped together form the male parent."
msgstr ""
"{bold}policruzamiento:{end_bold} Crea un grupo de cruces de polinización "
"abierta. Cada accesión de la lista seleccionada se convierte en el "
"progenitor femenino de un cruce abierto, y todos los miembros de la lista "
"agrupados forman el progenitor masculino."

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
#, perl-brace-format
msgid ""
"{bold}reciprocal:{end_bold} Creates a group of biparental crosses. Starting "
"with a list of accessions, all possible biparental cross combinations are "
"made between them."
msgstr ""
"{bold}cruzamiento recíproco:{end_bold} Crea un grupo de cruces biparentales. "
"A partir de una lista de accesiones, se realizan todas las combinaciones "
"posibles de cruces biparentales entre ellas."

#: mason/breeders_toolbox/cross/add_cross_dialogs.mas
#, perl-brace-format
msgid ""
"{bold}multicross:{end_bold} Creates a group of biparental crosses. Starting "
"with a list of maternal accessions and a list of paternal accessions, direct "
"crosses are made in order."
msgstr ""
"{bold}cruces múltiples:{end_bold} Crea un grupo de cruces biparentales. A "
"partir de una lista de accesiones maternas y otra de accesiones paternas, se "
"realizan cruces directos en orden."

