msgstr "No, voy a subir ortofotomosaicos ensamblados o imágenes completas"

#: mason/breeders_toolbox/drone_imagery/upload_drone_imagery_dialogs.mas
msgid ""
"Yes, I am uploading a zipfile of raw images to stitch using OpenDroneMap"
msgstr ""
