#: mason/breeders_toolbox/manage_drone_imagery.mas
msgid ""
"Please give the top-most rows left margin! This can be 0 if there is no "
"offset."
msgstr ""
"¡Indique el margen izquierdo de las filas superiores! Puede ser 0 si no hay "
"desplazamiento."

