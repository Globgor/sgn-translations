"{column}: Optional identifier for each NIRS read. The {identifier} must be "
"an integer."
msgstr ""
"{column}: Identificador opcional para cada lectura NIRS. El {identifier} "
"debe ser un número entero."

#: mason/breeders_toolbox/upload_nirs_spreadsheet_dialogs.mas
#, perl-brace-format
msgid "{column}: Optional identifier for each sample. Strings are allowed."
msgstr ""
"{column}: Identificador opcional para cada muestra. Se permiten cadenas de "
