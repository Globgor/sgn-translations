#: lib/SGN/Controller/AJAX/Accessions.pm
msgid "You must be logged in to upload this info!"
msgstr "Debe iniciar sesión para cargar esta información."

#: lib/SGN/Controller/AJAX/Accessions.pm
msgid "You need to be logged in to add accessions."
msgstr "Debe iniciar sesión para añadir accesiones."

#: lib/SGN/Controller/AJAX/Accessions.pm
msgid "You have insufficient privileges to add accessions."
msgstr "No tiene permisos suficientes para añadir accesiones."

#: lib/SGN/Controller/AJAX/Accessions.pm
#: lib/SGN/Controller/AJAX/GenotypingQC.pm
msgid "You must be logged in to upload this seedlot info!"
msgstr "Debe iniciar sesión para cargar esta información de lotes de semillas!"

#: lib/SGN/Controller/AJAX/Accessions.pm
#: lib/SGN/Controller/AJAX/VectorConstruct.pm
msgid "Only a curator, submitter or sequencer can upload a file"
msgstr "Solo un curador, remitente o secuenciador puede cargar un archivo"

#: lib/SGN/Controller/AJAX/Accessions.pm lib/SGN/Controller/AJAX/Pedigrees.pm
#: lib/SGN/Controller/AJAX/Trial.pm lib/SGN/Controller/AJAX/VectorConstruct.pm
msgid "Could not get parsing errors"
msgstr "No se pudieron obtener los errores de análisis"

#: lib/SGN/Controller/AJAX/Accessions.pm
msgid "You need to be logged in to submit accessions."
msgstr "Debe iniciar sesión para enviar accesiones."

#: lib/SGN/Controller/AJAX/Accessions.pm
msgid "You have insufficient privileges to submit accessions."
msgstr "No tiene permisos suficientes para enviar accesiones."

#: lib/SGN/Controller/AJAX/Accessions/Rename.pm
#: lib/SGN/Controller/AJAX/Grafting.pm lib/SGN/Controller/AJAX/Seedlot.pm
msgid "You must be logged in to upload seedlots!"
msgstr "¡Debe iniciar sesión para cargar lotes de semillas!"

#: lib/SGN/Controller/AJAX/Accessions/Rename.pm
msgid "You have insufficient privileges to rename accessions."
msgstr "No tiene permisos suficientes para renombrar accesiones."

#: lib/SGN/Controller/AJAX/Accessions/Rename.pm
msgid ""
"The rename accessions funtion requires a tab delimited file. Excel files "
"(.xls and .xlsx) are currently not supported. Please convert the file and "
"try again."
msgstr ""
"La función para renombrar accesiones requiere un archivo delimitado por "
"tabulaciones. Actualmente no se admiten archivos Excel (.xls y .xlsx). "
"Convierta el archivo e inténtelo de nuevo."

#: lib/SGN/Controller/AJAX/Analysis.pm
msgid "You are trying to save an analysis, but no name was given."
msgstr "Está intentando guardar un análisis, pero no indicó ningún nombre."

#: lib/SGN/Controller/AJAX/Analysis.pm
msgid "Analysis result type not accepted!"
msgstr "¡No se acepta el tipo de resultado del análisis!"

#: lib/SGN/Controller/AJAX/Analysis.pm
msgid ""
"This model still has analyses associated! Please delete the analyses before "
"deleting this model!"
msgstr ""
"¡Este modelo todavía tiene análisis asociados! ¡Elimine los análisis antes "
"de eliminar el modelo!"

#: lib/SGN/Controller/AJAX/Analysis.pm lib/SGN/Controller/AJAX/Analytics.pm
#: lib/SGN/Controller/AJAX/DroneImagery/DroneImageryUpload.pm
#: lib/SGN/Controller/AJAX/FileShareDump.pm
#: lib/SGN/Controller/AJAX/HighDimensionalPhenotypes.pm
#: lib/SGN/Controller/AJAX/Seedlot.pm
#: lib/SGN/Controller/AJAX/SequenceMetadata.pm
msgid "You must be logged in to do this!"
msgstr "Debe iniciar sesión para realizar esta operación!"

#: lib/SGN/Controller/AJAX/Analysis.pm lib/SGN/Controller/AJAX/Analytics.pm
msgid "You must have permission to do this! Please contact us!"
msgstr ""
"¡Necesita permiso para realizar esta acción! ¡Póngase en contacto con "
"nosotros!"

#: lib/SGN/Controller/AJAX/Analytics.pm
msgid "No ID given!"
msgstr "¡No se indicó ningún ID!"

#: lib/SGN/Controller/AJAX/Analyze/Phenotypes.pm
msgid "Error in R script R/Anova.R"
msgstr "Error en el script de R R/Anova.R"

#: lib/SGN/Controller/AJAX/BreederSearch.pm
msgid ""
"Over 10,000 matches. Speeds may be affected, consider narrowing your search"
msgstr ""
"Más de 10,000 coincidencias. La velocidad puede verse afectada; considere "
"restringir la búsqueda"

#: lib/SGN/Controller/AJAX/BreedersToolbox.pm
msgid ""
"You need to be logged in with curator privileges to delete a breeding "
"program."
msgstr ""
"Debe iniciar sesión con permisos de curador para eliminar un programa de "
"mejoramiento."

#: lib/SGN/Controller/AJAX/BreedersToolbox.pm
msgid "You need to be logged in to add a data agreement"
msgstr "Debe iniciar sesión para añadir un acuerdo de datos"

#: lib/SGN/Controller/AJAX/BreedersToolbox.pm
msgid ""
"You do not have the required privileges to add a data agreement to this "
"trial."
msgstr ""
"No tiene los permisos necesarios para añadir un acuerdo de datos a este "
"ensayo."

#: lib/SGN/Controller/AJAX/BreedersToolbox.pm
msgid "Updated data agreement."
msgstr "Acuerdo de datos actualizado."

#: lib/SGN/Controller/AJAX/BreedersToolbox.pm
msgid "Inserted new data agreement."
msgstr "Se añadió un nuevo acuerdo de datos."

#: lib/SGN/Controller/AJAX/BreedersToolbox.pm
msgid "No data agreements have been added yet."
msgstr "Todavía no se han añadido acuerdos de datos."

#: lib/SGN/Controller/AJAX/BreedersToolbox/Folder.pm
#: lib/SGN/Controller/AJAX/Trial.pm
msgid ""
"A folder or trial with that name already exists in the database. Please "
"select another name."
msgstr ""
"Ya existe una carpeta o un ensayo con ese nombre en la base de datos. Elija "
"otro nombre."

#: lib/SGN/Controller/AJAX/BreedersToolbox/Folder.pm
msgid ""
"Folder Not Deleted! To delete a folder first move all trials and sub-folders "
"out of it."
msgstr ""
"¡Carpeta no eliminada! Para eliminarla, mueva primero todos los ensayos y "
"subcarpetas fuera de ella."

#: lib/SGN/Controller/AJAX/BreedersToolbox/Folder.pm
msgid "Folder could not be renamed!"
msgstr "¡No se pudo cambiar el nombre de la carpeta!"

#: lib/SGN/Controller/AJAX/BreedersToolbox/Folder.pm
msgid "You need to be logged in."
msgstr "Debe iniciar sesión."

#: lib/SGN/Controller/AJAX/BreedersToolbox/Folder.pm
msgid "You have insufficient privileges."
msgstr "No tiene permisos suficientes."

#: lib/SGN/Controller/AJAX/BreedersToolbox/Population.pm
msgid "You must be logged in to create a population!"
msgstr "¡Debe iniciar sesión para crear una población!"

#: lib/SGN/Controller/AJAX/BreedersToolbox/Population.pm
msgid "Only a submitter or a curator can create a population"
msgstr "Solo un remitente de datos o un curador puede crear una población"

#: lib/SGN/Controller/AJAX/BreedersToolbox/Population.pm
msgid "You must be logged in to add population members!"
msgstr "¡Debe iniciar sesión para añadir miembros a una población!"

#: lib/SGN/Controller/AJAX/BreedersToolbox/Population.pm
msgid "Only a submitter or a curator can add population members"
msgstr ""
"Solo un remitente de datos o un curador puede añadir miembros a una población"

#: lib/SGN/Controller/AJAX/BreedersToolbox/Population.pm
msgid "You must be logged in to delete a population!"
msgstr "¡Debe iniciar sesión para eliminar una población!"

#: lib/SGN/Controller/AJAX/BreedersToolbox/Population.pm
msgid "Only a curator can delete a population"
msgstr "Solo un curador puede eliminar una población"

#: lib/SGN/Controller/AJAX/BreedersToolbox/Population.pm
msgid "No such population exists. Cannot delete."
msgstr "No existe esa población. No se puede eliminar."

#: lib/SGN/Controller/AJAX/BreedersToolbox/Population.pm
msgid "You must be logged in to remove an accession from population!"
msgstr "¡Debe iniciar sesión para quitar una accesión de una población!"

#: lib/SGN/Controller/AJAX/BreedersToolbox/Population.pm
msgid "Only a curator can remove an accession from population"
msgstr "Solo un curador puede quitar una accesión de una población"

#: lib/SGN/Controller/AJAX/Captcha.pm
msgid "Missing server captcha config"
msgstr "Falta la configuración de CAPTCHA del servidor"

#: lib/SGN/Controller/AJAX/Catalog.pm
msgid "You must be logged in to add a catalog item."
msgstr "Debe iniciar sesión para añadir un artículo al catálogo."

#: lib/SGN/Controller/AJAX/Catalog.pm
msgid "Item name is not in the database or not unique in the database!"
msgstr ""
"El nombre del artículo no está en la base de datos o no es único en ella!"

#: lib/SGN/Controller/AJAX/Catalog.pm
msgid "Contact person has no record in the database!"
msgstr "La persona de contacto no tiene un registro en la base de datos!"

#: lib/SGN/Controller/AJAX/Catalog.pm
msgid "Breeding program is not in the database!"
msgstr "El programa de mejoramiento no está en la base de datos!"

#: lib/SGN/Controller/AJAX/Catalog.pm
msgid "Error saving catalog item"
msgstr "Error al guardar el artículo del catálogo"

#: lib/SGN/Controller/AJAX/Catalog.pm
msgid "You must be logged in to upload!"
msgstr "Debe iniciar sesión para cargar archivos!"

#: lib/SGN/Controller/AJAX/Catalog.pm
msgid "You must be logged in to upload catalog items!"
msgstr "Debe iniciar sesión para cargar artículos del catálogo!"

#: lib/SGN/Controller/AJAX/Catalog.pm
msgid "Item name is not unique in the database!"
msgstr "El nombre del artículo no es único en la base de datos!"

#: lib/SGN/Controller/AJAX/Catalog.pm
msgid "Error saving catalog items"
msgstr "Error al guardar los artículos del catálogo"

#: lib/SGN/Controller/AJAX/Catalog.pm
msgid "You must be logged in to add a catalog image."
msgstr "Debe iniciar sesión para añadir una imagen al catálogo."

#: lib/SGN/Controller/AJAX/Catalog.pm
msgid "Item name is not in the database!"
msgstr "El nombre del artículo no está en la base de datos!"

#: lib/SGN/Controller/AJAX/Catalog.pm
msgid "Error saving catalog image"
msgstr "Error al guardar la imagen del catálogo"

#: lib/SGN/Controller/AJAX/Catalog.pm
msgid "An error occurred attempting to delete a catalog item."
msgstr "Se produjo un error al intentar eliminar un artículo del catálogo."

#: lib/SGN/Controller/AJAX/Catalog.pm
msgid "You must be logged in to add catalog items."
msgstr "Debe iniciar sesión para añadir elementos al catálogo."

#: lib/SGN/Controller/AJAX/Collection.pm
msgid "You must be logged in to do this."
msgstr "Debe iniciar sesión para realizar esta operación."

#: lib/SGN/Controller/AJAX/Collection.pm
msgid "collection was not found."
msgstr "No se encontró la colección."

#: lib/SGN/Controller/AJAX/Collection.pm
msgid "Only the collection's creator or a curator can modify it."
msgstr "Solo el creador de la colección o un curador puede modificarla."

#: lib/SGN/Controller/AJAX/Collection.pm
msgid "No valid ids were supplied."
msgstr "No se proporcionaron identificadores válidos."

#: lib/SGN/Controller/AJAX/Collection.pm
msgid "item_type must be 'image' or 'file'."
msgstr "item_type debe ser 'image' o 'file'."

#: lib/SGN/Controller/AJAX/Collection.pm
msgid "project_id must be numeric."
msgstr "project_id debe ser numérico."

#: lib/SGN/Controller/AJAX/Collection.pm
msgid "Collection created, but breeding_program_id must be numeric."
msgstr "Se creó la colección, pero breeding_program_id debe ser numérico."

#: lib/SGN/Controller/AJAX/Collection.pm
msgid "A valid item_id is required."
msgstr "Se requiere un item_id válido."

#: lib/SGN/Controller/AJAX/Collection.pm
msgid "A valid trial_id is required."
msgstr "Se requiere un trial_id válido."

#: lib/SGN/Controller/AJAX/Contact.pm
msgid "You must be a clever bot"
msgstr "Debe ser un bot inteligente"

#: lib/SGN/Controller/AJAX/Contact.pm
msgid "The message was not posted to github correctly. Please try again."
msgstr "El mensaje no se publicó correctamente en github. Inténtelo de nuevo."

#: lib/SGN/Controller/AJAX/Contact.pm
msgid "There was an error submitting the message. Please try again."
msgstr "Se produjo un error al enviar el mensaje. Inténtelo de nuevo."

#: lib/SGN/Controller/AJAX/Dataset.pm
msgid "Login required to perform requested action."
msgstr "Debe iniciar sesión para realizar la acción solicitada."

#: lib/SGN/Controller/AJAX/Dataset.pm
msgid "No logged in user to display dataset information for."
msgstr ""
"No hay un usuario conectado para mostrar su información de conjuntos de "
"datos."

#: lib/SGN/Controller/AJAX/Dataset.pm
msgid "No logged in user error."
msgstr "Error: no hay un usuario conectado."

#: lib/SGN/Controller/AJAX/Dataset.pm
msgid "Only the owner can change a dataset"
msgstr "Solo el propietario puede modificar un conjunto de datos"

#: lib/SGN/Controller/AJAX/Dataset.pm
msgid "Deleting datasets requires login"
msgstr "Debe iniciar sesión para eliminar conjuntos de datos"

#: lib/SGN/Controller/AJAX/Dataset.pm
msgid "Only the owner can delete a dataset"
msgstr "Solo el propietario puede eliminar un conjunto de datos"

#: lib/SGN/Controller/AJAX/Dataset.pm lib/SGN/Controller/Dataset.pm
msgid "The selected service does not exist in the server configuration"
msgstr "El servicio seleccionado no existe en la configuración del servidor"

#: lib/SGN/Controller/AJAX/Dataset.pm
msgid "Only the owner can publish a dataset"
msgstr "Solo el propietario puede publicar un conjunto de datos"

#: lib/SGN/Controller/AJAX/Dataset.pm
msgid "Could not generate archive file"
msgstr "No se pudo generar el archivo de almacenamiento"

#: lib/SGN/Controller/AJAX/Dataset.pm
msgid "The specified file does not exist"
msgstr "El archivo especificado no existe"

#: lib/SGN/Controller/AJAX/Dataset.pm
msgid "The specified published metadata does not exist"
msgstr "Los metadatos publicados especificados no existen"

#: lib/SGN/Controller/AJAX/Dataset.pm
msgid "Could not publish the selected article"
msgstr "No se pudo publicar el registro seleccionado"

#: lib/SGN/Controller/AJAX/Dataset.pm
msgid "Could not get a DOI for the selected article"
msgstr "No se pudo obtener un DOI para el registro seleccionado"

#: lib/SGN/Controller/AJAX/DeriveTrait.pm
msgid "You need to be logged in to compute trait."
msgstr "Debe iniciar sesión para calcular el carácter."

#: lib/SGN/Controller/AJAX/DeriveTrait.pm
msgid "You have insufficient privileges to compute trait."
msgstr "No tiene permisos suficientes para calcular el carácter."

#: lib/SGN/Controller/AJAX/DeriveTrait.pm
msgid "No trait assayed for this trial."
msgstr "No se ha medido ningún carácter en este ensayo."

#: lib/SGN/Controller/AJAX/DeriveTrait.pm
msgid "Select trait to compute."
msgstr "Seleccione el carácter que desea calcular."

#: lib/SGN/Controller/AJAX/DeriveTrait.pm
msgid "Must be a curator to overwrite values! Please contact us!"
msgstr ""
"Se requieren privilegios de curador para sobrescribir valores. ¡Póngase en "
"contacto con nosotros!"

#: lib/SGN/Controller/AJAX/DocumentBrowser.pm
msgid "Must be logged in!"
msgstr "Debe iniciar sesión!"

#: lib/SGN/Controller/AJAX/DocumentBrowser.pm
msgid "Problem archiving the file!"
msgstr "Problema al archivar el archivo!"

#: lib/SGN/Controller/AJAX/DocumentBrowser.pm
msgid "Problem retrieving file md5!"
msgstr "Problema al obtener el md5 del archivo!"

#: lib/SGN/Controller/AJAX/DocumentBrowser.pm
msgid "Successfully saved file!"
msgstr "El archivo se guardó correctamente!"

#: lib/SGN/Controller/AJAX/DroneImagery/DroneImageryUpload.pm
msgid ""
"Please use a globally unique drone run name! The name you specified has "
"already ben used."
msgstr ""
"Utilice un nombre de evento de captura con dron que sea único globalmente! "
"El nombre indicado ya se ha utilizado."

#: lib/SGN/Controller/AJAX/DroneImagery/DroneImageryUpload.pm
msgid "Please select a field trial!"
msgstr "Selecciona un ensayo de campo."

#: lib/SGN/Controller/AJAX/DroneImagery/DroneImageryUpload.pm
msgid "Please give an imaging event vehicle id!"
msgstr "Indica el identificador de la plataforma de captura."

#: lib/SGN/Controller/AJAX/DroneImagery/DroneImageryUpload.pm
msgid "Please select an imaging event or create a new imaging event!"
msgstr "Selecciona un evento de captura o crea uno nuevo."

#: lib/SGN/Controller/AJAX/DroneImagery/DroneImageryUpload.pm
msgid "Please give a new imaging event type!"
msgstr "Indica el tipo del nuevo evento de captura."

#: lib/SGN/Controller/AJAX/DroneImagery/DroneImageryUpload.pm
msgid "Please give a new imaging event date!"
msgstr "Indica la fecha del nuevo evento de captura."

#: lib/SGN/Controller/AJAX/DroneImagery/DroneImageryUpload.pm
msgid "Please give a new imaging event date in the format YYYY/MM/DD HH:mm:ss!"
msgstr ""
"Indica la fecha del nuevo evento de captura en formato YYYY/MM/DD HH:mm:ss."

#: lib/SGN/Controller/AJAX/DroneImagery/DroneImageryUpload.pm
msgid ""
"Please give a new imaging event base date in the format YYYY/MM/DD HH:mm:ss!"
msgstr ""
"Indica la fecha base del nuevo evento de captura en formato YYYY/MM/DD "
"HH:mm:ss."

#: lib/SGN/Controller/AJAX/DroneImagery/DroneImageryUpload.pm
msgid "Please give a new imaging event description!"
msgstr "Indica una descripción del nuevo evento de captura."

#: lib/SGN/Controller/AJAX/DroneImagery/DroneImageryUpload.pm
msgid "Please indicate the type of camera!"
msgstr "Indica el tipo de cámara."

#: lib/SGN/Controller/AJAX/DroneImagery/DroneImageryUpload.pm
msgid "Please give the number of new imaging event bands!"
msgstr "Indica el número de bandas del nuevo evento de captura."

#: lib/SGN/Controller/AJAX/DroneImagery/DroneImageryUpload.pm
msgid "Please indicate if the images are stitched!"
msgstr "Indica si las imágenes están unidas."

#: lib/SGN/Controller/AJAX/DroneImagery/DroneImageryUpload.pm
msgid "Please provide a zipfile of raw images!"
msgstr "Proporciona un ZIP de imágenes originales."

#: lib/SGN/Controller/AJAX/DroneImagery/DroneImageryUpload.pm
msgid ""
"Please provide a zipfile of images of the Micasense radiometric calibration "
"panels!"
msgstr ""
"Proporciona un ZIP con imágenes de los paneles de calibración radiométrica "
"Micasense."

#: lib/SGN/Controller/AJAX/DroneImagery/DroneImageryUpload.pm
msgid ""
"There are already the maximum number of OpenDroneMap processes running on "
"this machine! Please check back later when those processes are complete."
msgstr ""
"Ya se está ejecutando el número máximo de procesos OpenDroneMap en este "
"equipo. Vuelve a intentarlo cuando terminen."

#: lib/SGN/Controller/AJAX/DroneImagery/DroneImageryUpload.pm
msgid ""
"An imaging event has already occured on this field trial at the same date "
"and time! Please give a unique date/time for each imaging event!"
msgstr ""
"Ya se realizó un evento de captura en este ensayo de campo en la misma fecha "
"y hora! Indique una fecha y hora únicas para cada evento de captura!"

#: lib/SGN/Controller/AJAX/DroneImagery/DroneImageryUpload.pm
msgid "Please give a new imaging event band name!"
msgstr "Indica el nombre de la banda del nuevo evento de captura."

#: lib/SGN/Controller/AJAX/DroneImagery/DroneImageryUpload.pm
msgid "Please give a new imaging event band description!"
msgstr "Indica una descripción de la banda del nuevo evento de captura."

#: lib/SGN/Controller/AJAX/DroneImagery/DroneImageryUpload.pm
msgid "Please give a new imaging event band type!"
msgstr "Indica el tipo de banda del nuevo evento de captura."

#: lib/SGN/Controller/AJAX/DroneImagery/DroneImageryUpload.pm
msgid "Please provide a zipfile OR a stitched ortho image!"
msgstr "Proporciona un ZIP O una ortofoto unida."

#: lib/SGN/Controller/AJAX/DroneImagery/DroneImageryUpload.pm
msgid "Please provide a drone image zipfile of raw images to stitch!"
msgstr ""
"Proporcione un archivo zip de imágenes originales de dron para unirlas!"

#: lib/SGN/Controller/AJAX/DroneImagery/DroneImageryUpload.pm
msgid "Please provide a drone image zipfile of raw images!"
msgstr "Proporcione un archivo zip de imágenes originales de dron!"

#: lib/SGN/Controller/AJAX/EnvironmentStratification.pm
msgid "Dataset id is required."
msgstr "Se requiere el identificador del conjunto de datos."

#: lib/SGN/Controller/AJAX/EnvironmentStratification.pm
msgid "Phenotype file is required."
msgstr "Se requiere un archivo de fenotipos."

#: lib/SGN/Controller/AJAX/EnvironmentStratification.pm
#: lib/SGN/Controller/AJAX/GCPC.pm lib/SGN/Controller/AJAX/Heritability.pm
#: lib/SGN/Controller/AJAX/MixedModels.pm
#: lib/SGN/Controller/AJAX/QualityControl.pm lib/SGN/Controller/AJAX/Solgwas.pm
#: lib/SGN/Controller/AJAX/SpatialModel.pm lib/SGN/Controller/AJAX/Stability.pm
msgid "Can't find data."
msgstr "No se pueden encontrar los datos."

#: lib/SGN/Controller/AJAX/EnvironmentStratification.pm
msgid "Dataset and trait are required."
msgstr "Se requieren el conjunto de datos y el carácter."

#: lib/SGN/Controller/AJAX/EnvironmentStratification.pm
msgid "Alpha must be a number between 0 and 1."
msgstr "Alfa debe ser un número entre 0 y 1."

#: lib/SGN/Controller/AJAX/FamilyName.pm
msgid ""
"You do not have the correct role to modify family members. Please contact us."
msgstr ""
"No tiene el rol necesario para modificar miembros de la familia. Contacte "
"con nosotros."

#: lib/SGN/Controller/AJAX/FamilyName.pm
msgid "You do not have the correct role to delete family. Please contact us."
msgstr ""
"No tiene el rol necesario para eliminar la familia. Contacte con nosotros."

#: lib/SGN/Controller/AJAX/FamilyName.pm
msgid "Only a submitter or a curator can add family members"
msgstr ""
"Solo un usuario que aporta datos o un curador puede añadir miembros de la "
"familia"

#: lib/SGN/Controller/AJAX/FileShareDump.pm
msgid "Could not store uploaded file!"
msgstr "¡No se pudo guardar el archivo cargado!"

#: lib/SGN/Controller/AJAX/GCPC.pm
msgid ""
"None of the traits in the selection index are present in the dataset. Please "
"choose another selection index."
msgstr ""
"Ninguno de los rasgos del índice de selección está presente en el conjunto "
"de datos. Elija otro índice de selección."

#: lib/SGN/Controller/AJAX/Genefamily/Manual.pm
#: lib/SGN/Controller/AJAX/Stock.pm
msgid "Nothing here, it's a GET.."
msgstr "No hay nada aquí, es un GET.."

#: lib/SGN/Controller/AJAX/Genefamily/Manual.pm
#: lib/SGN/Controller/AJAX/Stock.pm
msgid "Must be logged in for associating loci! "
msgstr "¡Debe iniciar sesión para asociar loci! "

#: lib/SGN/Controller/AJAX/Genefamily/Manual.pm
msgid ""
"need both valid locusgroup_id and locus_id for adding the locusgroup member! "
msgstr ""
"Se requieren un locusgroup_id y un locus_id válidos para añadir el miembro "
"al grupo de loci! "

#: lib/SGN/Controller/AJAX/GenotypesVCFUpload.pm
msgid "You must be logged in to upload this VCF genotype info!"
msgstr "Debe iniciar sesión para cargar estos datos de genotipado VCF."

#: lib/SGN/Controller/AJAX/GenotypesVCFUpload.pm
#: lib/SGN/Controller/AJAX/GenotypingQC.pm
msgid ""
"Must have correct permissions to upload VCF genotypes! Please contact us."
msgstr ""
"Se requieren los permisos adecuados para cargar genotipos VCF. Póngase en "
"contacto con el administrador."

#: lib/SGN/Controller/AJAX/GenotypesVCFUpload.pm
msgid "Each genotyping project should be associated with only one protocol"
msgstr "Cada proyecto de genotipado debe estar asociado a un solo protocolo"

#: lib/SGN/Controller/AJAX/GenotypesVCFUpload.pm
msgid ""
"The selected genotyping project is already associated with different "
"protocol. Each project should be associated with only one protocol"
msgstr ""
