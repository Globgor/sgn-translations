msgid "Breeding Program(s):"
msgstr ""

#: mason/site/login_dialog.mas
msgid "Organization:"
msgstr "Organización:"

#: mason/site/login_dialog.mas
msgid "Username:"
msgstr "Nombre de usuario:"

#: mason/site/login_dialog.mas
msgid "Username must be at least 7 characters long."
msgstr "El nombre de usuario debe tener al menos 7 caracteres."

#: mason/site/login_dialog.mas
msgid "Password:"
msgstr "Contraseña:"

#: mason/site/login_dialog.mas
msgid ""
"Password must be at least 7 characters long and different from your username."
msgstr ""
"La contraseña debe tener al menos 7 caracteres y ser diferente del nombre de "
"usuario."

#: mason/site/login_dialog.mas
msgid "Confirm Password:"
msgstr ""

#: mason/site/login_dialog.mas
msgid "Email Address:"
msgstr ""

#: mason/site/login_dialog.mas
msgid ""
"An email will be sent to this address requiring you to confirm its receipt "
"to activate your account."
msgstr ""
"Recibirá un mensaje en esta dirección; deberá confirmar su recepción para "
"activar la cuenta."

