msgstr ""
"{column}: Campo obligatorio que corresponde a datos existentes en la base de "
"datos. Puede ser el nombre de la parcela, de la subparcela, de la planta o "
"de la muestra de tejido, según el diseño del ensayo."

#: mason/breeders_toolbox/upload_nirs_spreadsheet_dialogs.mas
#, perl-brace-format
msgid "{column}: Optional field to identify your device. Strings are allowed."
msgstr ""
"{column}: Campo opcional para identificar su dispositivo. Se permiten "
"cadenas de texto."

#: mason/breeders_toolbox/upload_nirs_spreadsheet_dialogs.mas
#, perl-brace-format
msgid "{column}: Optional field for general comments."
msgstr "{column}: Campo opcional para comentarios generales."

#: mason/breeders_toolbox/upload_nirs_spreadsheet_dialogs.mas
