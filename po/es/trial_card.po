msgctxt "trial.upload.workflow.complete_step"
msgid "Complete"
msgstr "Completar"

#: mason/breeders_toolbox/trial/trial_upload_dialogs.mas:135
msgctxt "trial.upload.workflow.enter_info_title"
msgid "Enter information about the experiment and upload your trial layout"
msgstr "Introduzca información sobre el experimento y cargue el diseño del ensayo"

#: mason/breeders_toolbox/trial/trial_upload_dialogs.mas:54
msgctxt "trial.upload.workflow.file_format_step"
msgid "File Formatting"
msgstr "Formato del archivo"

#: mason/breeders_toolbox/trial/trial_upload_dialogs.mas:591
msgctxt "trial.upload.workflow.finished_title"
msgid "Finished! Your trial is now in the database"
msgstr "¡Listo! Su ensayo ya está en la base de datos"

#: mason/breeders_toolbox/trial/trial_upload_dialogs.mas:495
msgctxt "trial.upload.workflow.fix_accessions_title"
msgid "Fixing the missing accession(s) problem"
msgstr "Resolver el problema de accesiones faltantes"

#: mason/breeders_toolbox/trial/trial_upload_dialogs.mas:530
msgctxt "trial.upload.workflow.fix_seedlots_title"
msgid "Fixing the missing seedlot(s) problem"
msgstr "Resolver el problema de lotes de semillas faltantes"

#: mason/breeders_toolbox/trial/trial_upload_dialogs.mas:41
msgctxt "trial.upload.workflow.intro_step"
msgid "Intro"
msgstr "Introducción"

#: mason/breeders_toolbox/trial/trial_upload_dialogs.mas:423
msgctxt "trial.upload.workflow.linkage_question"
msgid "Is your trial linked with other field trials, genotyping plates, or crossing experiments in the database? If you are unsure, you can skip this. This information can be added from the trial detail page after the trial is saved."
msgstr "¿Está vinculado este ensayo con otros ensayos de campo, placas de genotipado o experimentos de cruzamiento en la base de datos? Si no está seguro, puede omitirlo. Esta información se puede añadir desde la página de detalles después de guardar el ensayo."

#: mason/breeders_toolbox/trial/trial_upload_dialogs.mas:422
msgctxt "trial.upload.workflow.linkage_step"
msgid "Trial Linkage"
msgstr "Vinculación del ensayo"

#: mason/breeders_toolbox/trial/trial_upload_dialogs.mas:494
msgctxt "trial.upload.workflow.missing_accessions_step"
msgid "Fix missing accessions problem"
msgstr "Resolver el problema de accesiones faltantes"

#: mason/breeders_toolbox/trial/trial_upload_dialogs.mas:529
msgctxt "trial.upload.workflow.missing_seedlots_step"
msgid "Fix missing seedlots problem"
msgstr "Resolver el problema de lotes de semillas faltantes"

#: mason/breeders_toolbox/trial/trial_upload_dialogs.mas:419
msgctxt "trial.upload.workflow.next_step_caps"
msgid "Go To Next Step"
msgstr "Ir al siguiente paso"

#: mason/breeders_toolbox/trial/trial_upload_dialogs.mas:566
msgctxt "trial.upload.workflow.resubmit_step"
msgid "Try submitting trial again"
msgstr "Intentar enviar el ensayo de nuevo"

#: mason/breeders_toolbox/trial/trial_upload_dialogs.mas:567
msgctxt "trial.upload.workflow.resubmit_title"
msgid "Submit your trial again. You should have corrected all errors by now, but if not please take a look at the errors in the red box below. You can continue to modify your file and then click Upload until it works."
msgstr "Envíe el ensayo de nuevo. A estas alturas debería haber corregido todos los errores; si no, revise los errores del cuadro rojo. Puede seguir modificando el archivo y hacer clic en Cargar hasta que funcione."

#: mason/breeders_toolbox/trial/trial_upload_dialogs.mas:134
msgctxt "trial.upload.workflow.trial_info_step"
msgid "Enter trial information"
msgstr "Introducir información del ensayo"

#: mason/breeders_toolbox/trial/trial_upload_dialogs.mas:489
msgctxt "trial.upload.workflow.validate_form"
msgid "First validate the form"
msgstr "Primero valide el formulario"

#: mason/breeders_toolbox/trial/trial_upload_dialogs.mas:42
msgctxt "trial.upload.workflow.workflow_title"
msgid "This workflow will guide you through uploading a new trial or trials into the database"
msgstr "Este flujo le guiará para cargar uno o varios ensayos nuevos en la base de datos"

