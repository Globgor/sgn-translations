msgid "Please check the plot length"
msgstr "Revise el largo de parcela"

#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:156
msgctxt "trial.upload.ui.length_high"
msgid "Please check the plot length is too high"
msgstr "Revise el largo de parcela, es demasiado grande"

#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:141
msgctxt "trial.upload.ui.location"
msgid "Please give a location"
msgstr "Indique una ubicación"

#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:522
msgctxt "trial.upload.ui.metadata_success"
msgid "Success! All trials successfully updated."
msgstr "¡Éxito! Todos los ensayos se actualizaron correctamente."

#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:341
msgctxt "trial.upload.ui.multiple_success"
msgid "Success! All trials successfully loaded."
msgstr "¡Éxito! Todos los ensayos se cargaron correctamente."

#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:135
msgctxt "trial.upload.ui.name"
msgid "Please give a trial name"
msgstr "Indique un nombre de ensayo"

#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:199
msgctxt "trial.upload.ui.name_check"
msgid "An error occurred checking trial name"
msgstr "Se produjo un error al comprobar el nombre del ensayo"

#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:207
#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:309
#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:490
msgctxt "trial.upload.ui.no_file"
msgid "No file selected"
msgstr "No se ha seleccionado ningún archivo"

#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:245
msgctxt "trial.upload.ui.no_missing_accessions"
msgid "There were no errors regarding missing accessions Click Here"
msgstr "No hubo errores de accesiones faltantes. Haga clic aquí"

#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:255
