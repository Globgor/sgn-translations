msgid "An error occurred while trying to upload this file. Please check the formatting and try again"
msgstr "Se produjo un error al cargar este archivo. Revise el formato e inténtelo de nuevo"

#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:153
