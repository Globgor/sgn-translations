msgstr "Indique una descripción"

#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:168
msgctxt "trial.upload.ui.design"
msgid "Please give a design type"
msgstr "Indique un tipo de diseño"

#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:336
#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:517
msgctxt "trial.upload.ui.errors"
msgid "Errors found. Fix the following problems and try again."
msgstr "Se encontraron errores. Corrija los siguientes problemas e inténtelo de nuevo."

#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:171
#: mason/breeders_toolbox/upload_locations_dialogs.mas:90
msgctxt "trial.upload.ui.file"
msgid "Please select a file"
msgstr "Seleccione un archivo"

#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:354
#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:528
