msgstr "Revise el ancho de parcela"

#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:150
msgctxt "trial.upload.ui.width_high"
msgid "Please check the plot width is too high"
msgstr "Revise el ancho de parcela, es demasiado grande"

#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:144
msgctxt "trial.upload.ui.year"
msgid "Please give a trial year"
msgstr "Indique el año del ensayo"

