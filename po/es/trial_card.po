msgstr "No hubo errores de lotes de semillas faltantes. Haga clic aquí"

#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:129
msgctxt "trial.upload.ui.one_plant"
msgid "Only one plant per (row, column) coordinate is allowed. You must specify fewer plants per plot, or add rows and columns."
msgstr "Solo se permite una planta por coordenada (fila, columna). Indique menos plantas por parcela o añada filas y columnas."

#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:159
msgctxt "trial.upload.ui.plants_limit"
msgid "Please no more than 500 plants per plot."
msgstr "Indique como máximo 500 plantas por parcela."

#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:138
#: mason/analyses/store_new_analysis_values_and_model.mas:575
msgctxt "trial.upload.ui.program"
msgid "Please give a breeding program"
msgstr "Indique un programa de mejora"

#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:47
msgctxt "trial.upload.ui.program_first"
msgid "Please select a breeding program first"
msgstr "Seleccione primero un programa de mejora"

#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:347
msgctxt "trial.upload.ui.queued"
msgid "Your file has been uploaded.  You will receive an email once the process is complete."
msgstr "Su archivo se ha cargado. Recibirá un correo cuando finalice el proceso."

#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:287
msgctxt "trial.upload.ui.saved"
msgid "The trial was saved to the database with no errors! Congrats Click Here"
msgstr "¡El ensayo se guardó en la base de datos sin errores! Felicidades. Haga clic aquí"

#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:165
msgctxt "trial.upload.ui.stock_type"
msgid "Please select stock type being evaluated in trial"
msgstr "Seleccione el tipo de material evaluado en el ensayo"

#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:99
msgctxt "trial.upload.ui.templates_error"
msgid "Error loading plot name templates."
msgstr "Error al cargar las plantillas de nombres de parcelas."

#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:297
msgctxt "trial.upload.ui.upload_error"
msgid "There was an error uploading your trial."
msgstr "Se produjo un error al cargar el ensayo."

#: js/source/legacy/CXGN/BreedersToolbox/UploadTrial.js:279
