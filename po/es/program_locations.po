msgstr "Descripción de este formato de nombres."

#: mason/breeders_toolbox/program/add_autogenerated_name_metadata_dialog.mas:171
msgctxt "program.autoname.guide.format"
msgid "Format name must be globally unique. It is an identifier used for capturing all metadata related to each naming format."
msgstr "El nombre del formato debe ser único en todo el sistema. Es un identificador que agrupa todos los metadatos de cada formato."

