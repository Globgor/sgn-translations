msgstr "Autorizar acceso"

#: mason/brapi/authorize.mas:24
msgctxt "integrations.consent.deny"
msgid "Deny Access"
msgstr "Denegar acceso"

#: mason/brapi/authorize.mas:22
msgctxt "integrations.consent.explanation"
msgid " through your account. Use the buttons below to authorize or deny this request."
msgstr " a través de su cuenta. Use los botones siguientes para autorizar o denegar la solicitud."

#: mason/brapi/authorize.mas:21
msgctxt "integrations.consent.hello"
