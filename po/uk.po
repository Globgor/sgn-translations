msgid "You have insufficient privileges to add a trial."
msgstr "У вас недостатньо прав для додавання досліду."

#: lib/SGN/Controller/AJAX/Trial.pm
msgid "Treatment repeats do not equal number of plots in design"
msgstr "Кількість повторень варіантів не дорівнює кількості ділянок у схемі"

#: lib/SGN/Controller/AJAX/Trial.pm
msgid "Trial location not found"
msgstr "Місце проведення досліду не знайдено"

