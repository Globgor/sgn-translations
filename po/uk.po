#: lib/SGN/Controller/AJAX/Trials.pm
msgid "Trial name required"
msgstr "Потрібна назва досліду"

#: lib/SGN/Controller/AJAX/Trials.pm
msgid "Trial not found"
msgstr "Дослід не знайдено"

#: lib/SGN/Controller/AJAX/User.pm
msgid "Login credentials are incorrect. Please try again."
msgstr "Дані для входу неправильні. Спробуйте ще раз."

#: lib/SGN/Controller/AJAX/User.pm
msgid "Login successful"
msgstr "Вхід виконано"

#: lib/SGN/Controller/AJAX/User.pm
msgid "User successfully logged out."
msgstr "Вихід виконано успішно."

#: lib/SGN/Controller/AJAX/User.pm
msgid ""
"This site is a mirror site and does not support adding users. Please go to "
"the main site to create an account."
msgstr ""
"Цей сайт є дзеркалом і не підтримує додавання користувачів. Створіть "
"обліковий запис на основному сайті."

#: lib/SGN/Controller/AJAX/User.pm
msgid "You must be logged in to use this page."
msgstr "Щоб користуватися цією сторінкою, потрібно увійти в систему."

#: lib/SGN/Controller/AJAX/User.pm
msgid "Passwords must be at least 7 characters long. Please try again."
msgstr "Пароль має містити щонайменше 7 символів. Повторіть спробу."

#: lib/SGN/Controller/AJAX/User.pm
msgid ""
"New password entries do not match. You must enter your new password twice to "
"verify accuracy."
msgstr ""
"Введені нові паролі не збігаються. Введіть новий пароль двічі, щоб "
