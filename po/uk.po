#: lib/SGN/Controller/AJAX/Transformation.pm
msgid "you have insufficient privileges to add a transformation project."
msgstr "У вас недостатньо прав, щоб додати проєкт трансформації."

#: lib/SGN/Controller/AJAX/Transformation.pm
msgid "you have insufficient privileges to add a transformation ID."
msgstr "У вас недостатньо прав, щоб додати ID трансформації."

