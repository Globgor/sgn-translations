msgstr ""

#: mason/help/faq.mas
#, perl-brace-format
msgid ""
"This page contains questions that SGN users ask and are useful to the larger "
"SGN user community. Please {link}let us know{end_link} if you have a "
"question that you think should be added."
msgstr ""

#: mason/help/faq.mas
#, perl-brace-format
msgid "{bold}Question:{end_bold} Where can I order clones?"
msgstr ""

#: mason/help/faq.mas
#, perl-brace-format
msgid ""
"{bold}Answer:{end_bold} This depends on the species and on the specific "
"library."
msgstr ""

#: mason/help/faq.mas
#, perl-brace-format
msgid ""
"For tomato clones, you can use the clone ordering facility at the {link}"
"Boyce Thompson Institute{end_link}."
msgstr ""

#: mason/help/faq.mas
#, perl-brace-format
msgid ""
"For potato clones that were sequenced as part of the U.S. potato genome "
"project, the ordering is handled by the {link}Arizona Genome "
"Institute{end_link}."
msgstr ""

#: mason/help/faq.mas
#, perl-brace-format
msgid ""
"For all other libraries, please contact the library submitters given on the "
"library detail pages (use the {link}Library Search{end_link} page to find "
"the library in question)."
msgstr ""

#: mason/help/faq.mas
#, perl-brace-format
msgid ""
"{bold}Question:{end_bold} The SGN pages look really messed up on my browser."
msgstr ""

#: mason/help/faq.mas
#, perl-brace-format
msgid ""
"{bold}Answer:{end_bold} You are working with an old browser that does not "
"support style sheets, such as the browsers of the Netscape 4.x series. SGN "
"pages require style sheets and javascript to be turned on."
msgstr ""

#: mason/help/faq.mas
#, perl-brace-format
msgid "{bold}Question:{end_bold} Can I submit my data to SGN?"
msgstr ""

#: mason/help/faq.mas
#, perl-brace-format
msgid ""
"{bold}Answer:{end_bold} Please send us a message using the {link}contact "
"form{end_link} with a description of the data you would like to submit. We "
"will then work with you to integrate your data into the database and/or add "
"it to the FTP server."
msgstr ""

